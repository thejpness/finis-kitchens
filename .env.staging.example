# Copy to .env.staging on the VPS. This file is non-secret configuration.
# Staging must never reuse the production recipient or secrets directory.
DEPLOYMENT_ENV=staging
TRAEFIK_RESOURCE_PREFIX=finis-staging
TRAEFIK_NETWORK=traefik
SITE_DOMAIN=finiskitchens.southcoastapps.co.uk
PUBLIC_SITE_ORIGIN=https://finiskitchens.southcoastapps.co.uk
TRAEFIK_EXTRA_WEB_MIDDLEWARES=,finis-staging-noindex@docker
# While legacy finis-kitchens still claims this host, these priorities make
# staging deterministic: legacy web=10 and legacy enquiry=300.
TRAEFIK_WEB_ROUTER_PRIORITY=110
TRAEFIK_ENQUIRY_ROUTER_PRIORITY=400
SECRETS_DIR=./secrets-staging

# PUBLIC_* values are embedded in the browser build; use only public values.
PUBLIC_TURNSTILE_SITE_KEY=replace-with-staging-site-key

# Staging exercises the real path but sends only to a non-production recipient.
ADDR=:8080
UPSTREAM_URL=http://enquiry:8080/api/enquiry
ALLOW_ORIGIN=https://finiskitchens.southcoastapps.co.uk
MAX_BODY_BYTES=65536
SUBJECT_PREFIX=[FINIS STAGING]
# The contact UI currently requires consent but the live service uses false.
# Choose staging independently; do not change production silently.
REQUIRE_CONSENT=false
ENQUIRY_TO=replace-with-non-production-recipient
SUPPORT_TO=
SMTP_HOST=replace-with-staging-smtp-host
SMTP_PORT=587
SMTP_FROM=replace-with-staging-sender-address
