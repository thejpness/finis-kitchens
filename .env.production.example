# Copy to .env.production on the VPS. This file is non-secret configuration.
DEPLOYMENT_ENV=production
TRAEFIK_RESOURCE_PREFIX=finis-production
TRAEFIK_NETWORK=traefik
SITE_DOMAIN=finiskitchens.co.uk
WWW_DOMAIN=www.finiskitchens.co.uk
PUBLIC_SITE_ORIGIN=https://finiskitchens.co.uk
TRAEFIK_EXTRA_WEB_MIDDLEWARES=
# Preserve the established production router priorities.
TRAEFIK_WEB_ROUTER_PRIORITY=10
TRAEFIK_ENQUIRY_ROUTER_PRIORITY=300
SECRETS_DIR=./secrets

# PUBLIC_* values are embedded in the browser build; use only public values.
PUBLIC_TURNSTILE_SITE_KEY=replace-with-production-site-key

# Enquiry service and proxy configuration.
ADDR=:8080
UPSTREAM_URL=http://enquiry:8080/api/enquiry
ALLOW_ORIGIN=https://finiskitchens.co.uk,https://www.finiskitchens.co.uk
MAX_BODY_BYTES=65536
SUBJECT_PREFIX=[Website enquiry]
# The contact UI currently requires consent but the live service uses false.
# Preserve this setting until the business decision is made separately.
REQUIRE_CONSENT=false
ENQUIRY_TO=replace-with-production-recipient
SUPPORT_TO=
SMTP_HOST=replace-with-smtp-host
SMTP_PORT=587
SMTP_FROM=replace-with-sender-address
