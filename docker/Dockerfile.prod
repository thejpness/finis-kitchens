# syntax=docker/dockerfile:1.6

FROM node:22-alpine AS build

WORKDIR /app

# Build-time public envs for Astro/Vite.
# This is safe because PUBLIC_* values are client-visible by design.
ARG PUBLIC_TURNSTILE_SITE_KEY
ENV PUBLIC_TURNSTILE_SITE_KEY=$PUBLIC_TURNSTILE_SITE_KEY

COPY package*.json ./
RUN npm ci --silent --no-audit --fund=false

COPY . .
RUN npm run build


# Runtime: unprivileged Nginx.
# The unprivileged image listens on 8080 and runs as the nginx user.
FROM nginxinc/nginx-unprivileged:stable-alpine-slim AS runtime

# Temporarily switch to root during image build only.
# This lets us remove the startup script that tries to edit config at runtime,
# which creates noisy logs when the container root filesystem is read-only.
USER root

RUN rm -f /docker-entrypoint.d/10-listen-on-ipv6-by-default.sh

# Copy static site and Nginx config.
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

# Return to the unprivileged nginx user for runtime.
USER nginx

EXPOSE 8080