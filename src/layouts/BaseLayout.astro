---
// src/layouts/BaseLayout.astro
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/components.css";

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title = "Fini's Kitchens | Thoughtful Kitchen Design for Real Homes",
  description = "Fini's Kitchens designs and installs beautifully functional kitchens for real homes in and around Horsham.",
  ogImage = "/images/hero/default-hero.jpg",
  noindex = false,
} = Astro.props as Props;

const siteOrigin = (Astro.site?.toString() ?? "https://www.finiskitchens.co.uk").replace(/\/$/, "");

const toAbsoluteUrl = (pathOrUrl: string) => {
  try {
    return new URL(pathOrUrl).toString();
  } catch {
    return new URL(pathOrUrl, `${siteOrigin}/`).toString();
  }
};

const canonicalUrl = new URL(Astro.url.pathname, `${siteOrigin}/`).toString();
const ogImageUrl = toAbsoluteUrl(ogImage);

const robotsContent = noindex
  ? "noindex,nofollow"
  : "index,follow,max-image-preview:large";

const businessSchema = {
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "HomeAndConstructionBusiness"],
  "@id": `${siteOrigin}/#business`,
  name: "Fini's Kitchens",
  url: siteOrigin,
  description,
  image: ogImageUrl,
  priceRange: "£££",
  areaServed: [
    {
      "@type": "Place",
      name: "Horsham and surrounding areas",
    },
  ],
  serviceType: [
    "Kitchen design",
    "Kitchen supply",
    "Kitchen installation",
    "Kitchen renovation",
  ],
};
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta name="theme-color" content="#f9fafb" />
    <meta name="format-detection" content="telephone=no" />

    <link
      rel="preload"
      href="/fonts/InterVariable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content="Fini's Kitchens" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content="Fini's Kitchens" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" href="/favicon.ico?v=1" sizes="any" />

    <script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
  </head>

  <body>
    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />
  </body>
</html>