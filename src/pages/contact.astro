---
// src/pages/contact.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";

const TURNSTILE_SITE_KEY = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";
---

<BaseLayout
  title="Contact | Fini's Kitchens"
  description="Start with a conversation about your kitchen. Practical guidance and sensible next steps for homes in and around Horsham."
  footerFlush={true}
>
  <section class="contact-hero">
    <div class="container contact-hero__layout">
      <div class="contact-hero__copy">
        <p class="contact-eyebrow">Get in touch</p>
        <h1>Start with a conversation.</h1>
        <p class="contact-hero__summary">
          You do not need a finished brief or an exact specification before getting in touch.
          A rough idea of your room, your priorities and what needs to work better is enough to begin.
        </p>

        <div class="contact-hero__actions">
          <a class="btn btn--primary btn--large" href="#enquiry">Send an enquiry</a>
          <WhatsAppButton
            class="btn btn--ghost btn--large"
            label="Message on WhatsApp"
            text="Hi! I’d like to chat about a kitchen project."
          />
        </div>
      </div>

      <aside class="contact-hero__reassurance" aria-label="A simple way to get in touch">
        <p class="contact-eyebrow">A useful starting point</p>
        <p>
          Share what you know now. We can help make sense of the details and agree a sensible next step from there.
        </p>
        <a class="contact-hero__phone" href="tel:+447581390107">Call +44 7581 390 107</a>
      </aside>
    </div>
  </section>

  <section class="contact-enquiry" id="enquiry" aria-labelledby="contact-enquiry-title">
    <div class="container contact-enquiry__layout">
      <header class="contact-enquiry__intro">
        <p class="contact-eyebrow">Your enquiry</p>
        <h2 id="contact-enquiry-title">A little context is useful. Rough is fine.</h2>
        <p>
          A message helps us come prepared for the first conversation. There is no need to have every decision made;
          the useful starting points are simply the space, the timing and what matters most to you.
        </p>

        <ul class="contact-enquiry__notes">
          <li>Where the project is and what the room is like</li>
          <li>What you would like the kitchen to do better</li>
          <li>Any timing, budget or practical questions already on your mind</li>
        </ul>
      </header>

      <div class="contact-form-wrap">
        <header class="contact-form__head">
          <p class="contact-eyebrow">Send a message</p>
          <h3>Tell us what you know.</h3>
          <p>Fields marked <span aria-hidden="true">*</span> are required.</p>
        </header>

        <form id="enquiryForm" class="contact-form" novalidate>
          <!-- Honeypot: bots will fill this, humans won't see it -->
          <div class="hp" aria-hidden="true">
            <label for="company">Company</label>
            <input type="text" id="company" name="company" tabindex="-1" autocomplete="off" />
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="name">Your name <span aria-hidden="true">*</span></label>
              <input type="text" id="name" name="name" autocomplete="name" required />
            </div>

            <div class="form-group">
              <label for="email">Email <span aria-hidden="true">*</span></label>
              <input type="email" id="email" name="email" autocomplete="email" required />
            </div>
          </div>

          <div class="form-group">
            <label for="phone">Phone <span class="form-optional">(optional)</span></label>
            <input type="tel" id="phone" name="phone" autocomplete="tel" aria-describedby="phoneHelp" />
            <p class="field-help" id="phoneHelp">Useful if you would prefer a quick call back.</p>
          </div>

          <div class="form-group">
            <label for="timeline">How soon are you looking to have your new kitchen? <span aria-hidden="true">*</span></label>
            <select id="timeline" name="timeline" required aria-describedby="timelineHelp">
              <option value="">Select a timeframe</option>
              <option value="Less than 3 months">Less than 3 months</option>
              <option value="3-6 months">3-6 months</option>
              <option value="6-9 months">6-9 months</option>
              <option value="9+ months / I don't know">9+ months / I don't know</option>
            </select>
            <p class="field-help" id="timelineHelp">This helps us suggest sensible next steps and timings.</p>
          </div>

          <div class="form-group">
            <label for="message">Tell us about your project <span aria-hidden="true">*</span></label>
            <textarea
              id="message"
              name="message"
              rows="6"
              required
              placeholder="Where are you based? What style do you like? Any must-haves or challenges?"
            ></textarea>
          </div>

          <div class="form-group form-consent">
            <label class="check">
              <input type="checkbox" id="consent" name="consent" required />
              <span>
                You can contact me about this enquiry. <span aria-hidden="true">*</span>
                <span class="form-consent__note">No spam. Just kitchen stuff.</span>
              </span>
            </label>

            <p class="contact-form__privacy-note">
              We’ll only use the details you send to respond to your kitchen enquiry.
            </p>
          </div>

          <!-- Turnstile -->
          <div class="form-group turnstile-group">
            <div
              class="cf-turnstile"
              data-sitekey={TURNSTILE_SITE_KEY}
              data-callback="finisTurnstileOk"
              data-expired-callback="finisTurnstileExpired"
              data-error-callback="finisTurnstileError"
            ></div>

            <input type="hidden" id="captchaToken" name="captchaToken" value="" />
            <p class="turnstile-help" id="turnstileHelp" role="status" aria-live="polite"></p>
          </div>

          <button type="submit" class="btn btn--primary btn--large form-submit" id="submitBtn">
            Send message
          </button>

          <div class="form-status" id="formStatus" role="status" aria-live="polite" aria-atomic="true"></div>

          <p class="contact-form__fineprint">
            Prefer WhatsApp?
            <a
              class="contact-text-link"
              href="https://wa.me/447581390107?text=Hi!%20I%E2%80%99d%20like%20to%20chat%20about%20a%20kitchen%20project."
              target="_blank"
              rel="noopener"
            >
              Message us
            </a>.
          </p>

          <noscript>
            <p class="contact-form__fineprint">
              This form needs JavaScript enabled to send securely. If you prefer, email
              <a class="contact-text-link" href="mailto:oli.wyatt@thefinigroup.co.uk">oli.wyatt@thefinigroup.co.uk</a>
              or use WhatsApp above.
            </p>
          </noscript>
        </form>
      </div>
    </div>
  </section>

  <section class="contact-methods" aria-labelledby="contact-methods-title">
    <div class="container contact-methods__frame">
      <header class="contact-methods__intro">
        <p class="contact-eyebrow">Direct contact</p>
        <h2 id="contact-methods-title">Talk in the way that suits you.</h2>
        <p>Choose the simplest route. If a call is easier, include a rough time that works for you.</p>
      </header>

      <div class="contact-methods__list">
        <div class="contact-method">
          <span class="contact-method__number" aria-hidden="true">01</span>
          <div>
            <h3>WhatsApp</h3>
            <p>A quick message is enough to get the conversation started.</p>
          </div>
          <a
            class="contact-method__link"
            href="https://wa.me/447581390107?text=Hi!%20I%E2%80%99d%20like%20to%20chat%20about%20a%20kitchen%20project."
            target="_blank"
            rel="noopener"
          >
            Message on WhatsApp <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="contact-method">
          <span class="contact-method__number" aria-hidden="true">02</span>
          <div>
            <h3>Telephone</h3>
            <p>For a direct conversation about your room or plans.</p>
          </div>
          <a class="contact-method__link" href="tel:+447581390107">+44 7581 390 107 <span aria-hidden="true">→</span></a>
        </div>

        <div class="contact-method">
          <span class="contact-method__number" aria-hidden="true">03</span>
          <div>
            <h3>Email</h3>
            <p>Useful when you would rather write things down in your own time.</p>
          </div>
          <a class="contact-method__link" href="mailto:oli.wyatt@thefinigroup.co.uk">
            oli.wyatt@thefinigroup.co.uk <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="contact-showroom" aria-labelledby="contact-showroom-title">
    <div class="container contact-showroom__layout">
      <header>
        <p class="contact-eyebrow">Visit the showroom</p>
        <h2 id="contact-showroom-title">See the details in person.</h2>
      </header>

      <div class="contact-showroom__content">
        <p>
          Visiting the showroom is stage 02 of the process: a chance to see materials, finishes and options in person
          before detailed design work begins.
        </p>

        <div class="contact-showroom__address">
          <p class="contact-showroom__address-label">Ringmer showroom</p>
          <a
            href="https://www.google.com/maps/search/?api=1&query=Laughton%20Rd%2C%20Ringmer%2C%20Lewes%20BN8%205SY"
            target="_blank"
            rel="noopener"
          >
            Laughton Rd, Ringmer<br />
            Lewes BN8 5SY
          </a>
          <p>By appointment</p>
        </div>

        <div class="contact-showroom__actions">
          <a
            class="btn btn--ghost"
            href="https://www.google.com/maps/search/?api=1&query=Laughton%20Rd%2C%20Ringmer%2C%20Lewes%20BN8%205SY"
            target="_blank"
            rel="noopener"
          >
            Open in Maps
          </a>
          <a
            class="btn btn--ghost"
            href="https://www.google.com/maps/dir/?api=1&destination=Laughton%20Rd%2C%20Ringmer%2C%20Lewes%20BN8%205SY"
            target="_blank"
            rel="noopener"
          >
            Get directions
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="contact-next" aria-labelledby="contact-next-title">
    <div class="container contact-next__frame">
      <header class="contact-next__intro">
        <p class="contact-eyebrow">What happens next</p>
        <h2 id="contact-next-title">A clear first step, then the right next one.</h2>
        <p>There is no need to map the whole project before you make contact.</p>
      </header>

      <ol class="contact-next__list">
        <li>
          <span aria-hidden="true">01</span>
          <div>
            <h3>We read your enquiry</h3>
            <p>We take in the room, priorities and rough timing you have shared.</p>
          </div>
        </li>
        <li>
          <span aria-hidden="true">02</span>
          <div>
            <h3>We have an initial conversation</h3>
            <p>We talk through the useful details and answer the practical questions you have now.</p>
          </div>
        </li>
        <li>
          <span aria-hidden="true">03</span>
          <div>
            <h3>We agree the sensible next step</h3>
            <p>That might be a showroom visit, a survey or simply more guidance before deciding.</p>
          </div>
        </li>
      </ol>

      <a class="contact-next__link" href="/process">Read the full kitchen process <span aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script is:inline>
  window.finisTurnstileOk = (token) => {
    const input = document.getElementById("captchaToken");
    const help = document.getElementById("turnstileHelp");

    if (input) input.value = token || "";
    if (help) help.textContent = "";
  };

  window.finisTurnstileExpired = () => {
    const input = document.getElementById("captchaToken");
    const help = document.getElementById("turnstileHelp");

    if (input) input.value = "";
    if (help) help.textContent = "Security check expired - please try again.";
  };

  window.finisTurnstileError = () => {
    const input = document.getElementById("captchaToken");
    const help = document.getElementById("turnstileHelp");

    if (input) input.value = "";
    if (help) help.textContent = "Security check failed to load. Please refresh and try again.";
  };

  const $ = (id) => document.getElementById(id);

  const setStatus = (msg, type = "info") => {
    const el = $("formStatus");
    if (!el) return;

    el.className = `form-status form-status--${type}`;
    el.textContent = msg || "";
  };

  const setBusy = (busy) => {
    const btn = $("submitBtn");
    if (!btn) return;

    btn.disabled = !!busy;
    btn.setAttribute("aria-busy", busy ? "true" : "false");
    btn.textContent = busy ? "Sending…" : "Send message";
  };

  const resetTurnstile = () => {
    const tokenInput = $("captchaToken");
    if (tokenInput) tokenInput.value = "";

    if (window.turnstile && typeof window.turnstile.reset === "function") {
      try {
        window.turnstile.reset();
      } catch {}
    }
  };

  const getUTMSource = () => {
    try {
      const url = new URL(window.location.href);
      return (
        url.searchParams.get("utm_source") ||
        url.searchParams.get("utm_medium") ||
        url.searchParams.get("utm_campaign") ||
        ""
      );
    } catch {
      return "";
    }
  };

  document.addEventListener("DOMContentLoaded", () => {
    const form = $("enquiryForm");
    if (!form) return;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      setStatus("");

      const name = (form.querySelector("#name")?.value || "").trim();
      const email = (form.querySelector("#email")?.value || "").trim();
      const phone = (form.querySelector("#phone")?.value || "").trim();
      const timeline = (form.querySelector("#timeline")?.value || "").trim();
      const message = (form.querySelector("#message")?.value || "").trim();
      const company = (form.querySelector("#company")?.value || "").trim();
      const consent = !!form.querySelector("#consent")?.checked;
      const captchaToken = (form.querySelector("#captchaToken")?.value || "").trim();

      if (!name || name.length < 2) return setStatus("Please enter your name.", "error");
      if (!email || !email.includes("@")) return setStatus("Please enter a valid email.", "error");
      if (!timeline) return setStatus("Please choose a rough timeframe.", "error");
      if (!message || message.length < 10) return setStatus("Please add a little more detail.", "error");
      if (!consent) return setStatus("Please confirm we can contact you about this enquiry.", "error");
      if (!captchaToken) return setStatus("Please complete the security check.", "error");

      const payload = {
        name,
        email,
        phone: phone || undefined,
        timeline: timeline || undefined,
        message,
        page: window.location.href,
        source: getUTMSource(),
        consent,
        company,
        captchaToken,
        channel: "marketing",
      };

      setBusy(true);

      try {
        const res = await fetch("/api/enquiry", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });

        const data = await res.json().catch(() => ({}));

        if (!res.ok) {
          const msg = data?.error || "Something went wrong. Please try again.";
          setStatus(msg, "error");
          resetTurnstile();
          return;
        }

        setStatus("Thanks - message sent. We’ll be in touch shortly.", "success");
        form.reset();
        resetTurnstile();
      } catch (err) {
        setStatus("Network issue - please try again in a moment.", "error");
      } finally {
        setBusy(false);
      }
    });
  });
</script>

<style>
  .contact-hero {
    padding-block: clamp(4rem, 7vw, 6.25rem);
    background: var(--c-canvas-warm);
  }

  .contact-hero__layout {
    display: grid;
    gap: clamp(3rem, 7vw, 7rem);
    align-items: end;
  }

  .contact-enquiry__layout,
  .contact-methods__intro,
  .contact-showroom__layout,
  .contact-next__intro {
    display: grid;
    gap: var(--home-layout-gap);
    align-items: end;
  }

  .contact-hero__copy {
    max-width: 48rem;
  }

  .contact-eyebrow {
    margin-bottom: var(--space-4);
    color: var(--c-blue);
    font-size: var(--eyebrow-size);
    font-weight: var(--eyebrow-weight);
    line-height: var(--eyebrow-line-height);
    letter-spacing: var(--eyebrow-tracking);
    text-transform: uppercase;
  }

  .contact-hero h1 {
    max-width: 10ch;
    color: var(--c-ink);
    font-family: var(--font-display);
    font-size: clamp(3rem, 6vw, 5.8rem);
    font-weight: 450;
    line-height: 0.98;
    letter-spacing: -0.035em;
  }

  .contact-hero__summary {
    max-width: 42rem;
    margin-top: var(--space-6);
    color: var(--c-navy);
    font-size: clamp(1.08rem, 1.7vw, 1.3rem);
    line-height: var(--lh-snug);
  }

  .contact-hero__actions,
  .contact-showroom__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    align-items: center;
    margin-top: var(--space-7);
  }

  .contact-hero__reassurance {
    padding-top: var(--space-5);
    border-top: var(--border-1) solid var(--c-rule-blue);
  }

  .contact-hero__reassurance .contact-eyebrow {
    margin-bottom: var(--space-4);
  }

  .contact-hero__reassurance > p:not(.contact-eyebrow) {
    max-width: 35rem;
    color: var(--c-navy);
    font-size: clamp(1rem, 1.3vw, 1.12rem);
    line-height: 1.55;
  }

  .contact-hero__phone,
  .contact-text-link,
  .contact-next__link {
    color: var(--c-navy);
    font-weight: 650;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .contact-hero__phone {
    display: inline-block;
    margin-top: var(--space-5);
  }

  .contact-hero__phone:hover,
  .contact-text-link:hover {
    color: var(--c-blue);
    text-decoration-thickness: 2px;
  }

  .contact-enquiry {
    padding-block: var(--home-section-y);
    border-top: var(--border-1) solid var(--c-rule-blue);
    background: var(--c-paper);
  }

  .contact-enquiry__intro h2,
  .contact-showroom h2,
  .contact-next h2 {
    max-width: 13ch;
    color: var(--c-ink);
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 4.8vw, 4.6rem);
    font-weight: 450;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .contact-enquiry__intro > p:not(.contact-eyebrow) {
    max-width: 39rem;
    margin-top: var(--space-6);
    color: var(--c-navy);
    font-size: clamp(1rem, 1.3vw, 1.12rem);
    line-height: 1.65;
  }

  .contact-enquiry__notes {
    max-width: 39rem;
    padding: 0;
    margin: var(--space-7) 0 0;
    list-style: none;
    border-top: var(--border-1) solid var(--c-rule-blue);
  }

  .contact-enquiry__notes li {
    position: relative;
    padding: var(--space-4) 0 var(--space-4) 1.35rem;
    border-bottom: var(--border-1) solid var(--c-rule-blue);
    color: var(--c-navy);
    font-size: var(--fs-0);
    font-weight: 560;
    line-height: var(--lh-snug);
  }

  .contact-enquiry__notes li::before {
    content: "";
    position: absolute;
    top: calc(var(--space-4) + 0.68em);
    left: 0;
    width: 0.45rem;
    height: 0.45rem;
    transform: translateY(-50%);
    border-radius: 50%;
    background: var(--c-blue-muted);
  }

  .contact-form-wrap {
    min-width: 0;
    padding: clamp(1.5rem, 4vw, 3.5rem);
    background: var(--c-canvas-warm);
    border-top: var(--border-1) solid var(--c-rule-blue);
    border-bottom: var(--border-1) solid var(--c-rule-blue);
  }

  .contact-form__head {
    padding-bottom: var(--space-5);
    border-bottom: var(--border-1) solid var(--c-rule-blue);
  }

  .contact-form__head .contact-eyebrow {
    margin-bottom: var(--space-3);
  }

  .contact-form__head h3 {
    color: var(--c-ink);
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 2.8vw, 2.55rem);
    font-weight: 450;
    line-height: 1.02;
    letter-spacing: -0.03em;
  }

  .contact-form__head > p:last-child {
    margin-top: var(--space-3);
    color: var(--c-text-muted);
    font-size: var(--fs-0);
    line-height: var(--lh-snug);
  }

  .contact-form > * + * {
    margin-top: var(--space-6);
  }

  .form-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .form-group label {
    display: block;
    margin-bottom: var(--space-2);
    color: var(--c-ink);
    font-size: var(--fs-0);
    font-weight: 650;
    line-height: var(--lh-snug);
  }

  .form-optional,
  .field-help,
  .contact-form__privacy-note,
  .turnstile-help,
  .contact-form__fineprint,
  .form-consent__note {
    color: var(--c-text-muted);
    font-size: var(--fs-0);
    line-height: var(--lh-snug);
  }

  .field-help,
  .contact-form__privacy-note,
  .turnstile-help {
    margin-top: var(--space-2);
  }

  .form-group input,
  .form-group textarea,
  .form-group select {
    width: 100%;
    min-height: 3.1rem;
    padding: 0.8rem 0.9rem;
    border: var(--border-1) solid var(--c-border-strong);
    border-radius: 0.35rem;
    color: var(--c-ink);
    background: var(--c-paper);
    transition:
      border-color var(--dur-2) var(--ease-out),
      background var(--dur-2) var(--ease-out);
  }

  .form-group input:hover,
  .form-group textarea:hover,
  .form-group select:hover {
    border-color: var(--c-blue-muted);
  }

  .form-group input:focus-visible,
  .form-group textarea:focus-visible,
  .form-group select:focus-visible {
    border-color: var(--c-blue);
    outline: 3px solid color-mix(in srgb, var(--c-blue-pale) 78%, transparent);
    outline-offset: 2px;
  }

  .form-group textarea {
    min-height: 10rem;
    resize: vertical;
  }

  .form-group select {
    cursor: pointer;
  }

  .form-consent .check {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    color: var(--c-ink);
    cursor: pointer;
    user-select: none;
  }

  .form-consent input[type="checkbox"] {
    width: 1.1rem;
    min-width: 1.1rem;
    min-height: 1.1rem;
    height: 1.1rem;
    padding: 0;
    margin-top: 0.2rem;
    accent-color: var(--c-blue);
  }

  .form-consent__note {
    display: block;
    margin-top: var(--space-1);
  }

  .turnstile-group {
    min-width: 0;
  }

  .cf-turnstile,
  .cf-turnstile iframe {
    max-width: 100%;
  }

  .form-submit {
    width: 100%;
  }

  .form-status {
    padding: var(--space-3) var(--space-4);
    border: var(--border-1) solid var(--c-rule-blue);
    border-left: 3px solid var(--c-blue-muted);
