---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import { Picture } from "astro:assets";

export async function getStaticPaths() {
  const entries = await getCollection("projects");

  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props as {
  entry: Awaited<ReturnType<typeof getCollection<"projects">>>[number];
};

const data = entry?.data ?? {};
const { Content } = await render(entry);

const title = data.title ?? "Kitchen project";
const metaTitle = `${title} | Fini's Kitchens`;
const description =
  data.description ??
  "A real kitchen project designed and installed by Fini's Kitchens.";

const ogImage = data?.heroImage?.src ?? "/images/hero/default-hero.jpg";

const gallery = Array.isArray(data.gallery) ? data.gallery : [];
const hasGallery = gallery.length > 0;

const summaryPoints: { label: string; value: string }[] = [];

if (data.location) summaryPoints.push({ label: "Location", value: data.location });
if (data.projectType) summaryPoints.push({ label: "Project", value: data.projectType });
if (data.style) summaryPoints.push({ label: "Style", value: data.style });
if (data.completedAt) summaryPoints.push({ label: "Completed", value: data.completedAt });
---

<BaseLayout
  title={metaTitle}
  description={description}
  ogImage={ogImage}
>
  <section class="project-hero">
    <div class="container project-hero__frame">
      <div class="project-hero__copy">
        <p class="project-eyebrow">
          {data.location ? `Case study · ${data.location}` : "Case study"}
        </p>

        <h1>{title}</h1>

        <p class="project-hero__summary">{description}</p>
      </div>

      {
        summaryPoints.length > 0 && (
          <dl class="project-meta" aria-label="Project summary">
            {summaryPoints.map((item) => (
              <div>
                <dt>{item.label}</dt>
                <dd>{item.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>
  </section>

  {
    data.heroImage && (
      <section class="project-lead-image">
        <div class="container">
          <div class="project-lead-image__frame">
            <Picture
              src={data.heroImage}
              alt={`Finished ${title} kitchen`}
              formats={["avif", "webp"]}
              widths={[768, 1024, 1280, 1600, 1920]}
              sizes="(min-width: 80rem) 76rem, (min-width: 48rem) calc(100vw - 3.5rem), calc(100vw - 2rem)"
              loading="eager"
              decoding="async"
            />
          </div>
        </div>
      </section>
    )
  }

  <section class="project-story" aria-labelledby="project-story-title">
    <div class="container project-story__layout">
      <header class="project-story__intro">
        <p class="project-eyebrow">The project</p>
        <h2 id="project-story-title">Designed around the space that was already there.</h2>

        <p>
          The footprint did not need reinvention. The opportunity was to make the existing space
          more useful, more considered and much more personal to the client.
        </p>
      </header>

      <article class="project-prose">
        <Content />
      </article>
    </div>
  </section>

  {
    hasGallery && (
      <section class="project-gallery" aria-labelledby="project-gallery-title">
        <div class="container project-gallery__frame">
          <header class="project-gallery__intro">
            <div>
              <p class="project-eyebrow">Gallery</p>
              <h2 id="project-gallery-title">A closer look at Longleys Road.</h2>
            </div>

            <p>
              Materials, details and different views of the finished room.
            </p>
          </header>

          <div class="project-gallery__grid">
            {gallery.map((image, index) => (
              <figure>
                <Picture
                  src={image}
                  alt={`${title} finished kitchen view ${index + 1}`}
                  formats={["avif", "webp"]}
                  widths={[480, 768, 1024, 1280, 1600]}
                  sizes="(min-width: 64rem) 50vw, 100vw"
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="project-closing" aria-labelledby="project-closing-title">
    <div class="container">
      <div class="project-closing__frame">
        <div>
          <p class="project-eyebrow">Your kitchen</p>
          <h2 id="project-closing-title">Start with what needs to work better.</h2>
        </div>

        <div class="project-closing__content">
          <p>
            Tell us about your space, the things that frustrate you and what you want the finished
            kitchen to feel like. The design can grow from there.
          </p>

          <div class="project-closing__actions">
            <a class="btn btn--primary btn--large" href="/contact">
              Start a conversation
            </a>

            <a class="project-text-link" href="/projects">
              Back to case studies
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .project-eyebrow {
    margin-bottom: var(--space-4);
    color: var(--c-blue);
    font-size: var(--eyebrow-size);
    font-weight: var(--eyebrow-weight);
    line-height: var(--eyebrow-line-height);
    letter-spacing: var(--eyebrow-tracking);
    text-transform: uppercase;
  }

  .project-hero {
    padding-block: clamp(4rem, 7vw, 6.25rem);
    background: var(--c-canvas-warm);
  }

  .project-hero__frame {
    display: grid;
    gap: clamp(3rem, 7vw, 6rem);
    align-items: end;
  }

  .project-hero__copy h1 {
    max-width: 11ch;
    color: var(--c-ink);
    font-family: var(--font-display);
    font-size: clamp(3.2rem, 6.5vw, 6rem);
    font-weight: 450;
    line-height: 0.97;
    letter-spacing: -0.035em;
  }

  .project-hero__summary {
    max-width: 44rem;
    margin-top: var(--space-6);
    color: var(--c-navy);
    font-size: clamp(1.08rem, 1.7vw, 1.3rem);
    line-height: var(--lh-snug);
  }

  .project-meta {
    display: grid;
    margin: 0;
    border-top: var(--border-1) solid var(--c-rule-blue);
  }

  .project-meta > div {
    display: grid;
    grid-template-columns: minmax(6rem, 0.42fr) minmax(0, 1fr);
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-bottom: var(--border-1) solid var(--c-rule-blue);
  }

  .project-meta dt {
    color: var(--c-blue);
    font-size: var(--fs--1);
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .project-meta dd {
    margin: 0;
    color: var(--c-ink);
    font-weight: 600;
  }

  .project-lead-image {
    padding-block: var(--home-section-y-tight);
    border-top: var(--border-1) solid var(--c-rule-blue);
    background: var(--c-paper);
  }

  .project-lead-image__frame {
    overflow: hidden;
    border-radius: 0.75rem;
    background: var(--c-canvas-warm);
  }

  .project-lead-image__frame :global(picture),
  .project-lead-image__frame :global(img) {
    width: 100%;
    display: block;
  }

  .project-lead-image__frame :global(img) {
    height: auto;
  }

  .project-story {
    padding-block: var(--home-section-y);
    background: var(--c-paper);
  }

  .project-story__layout {
    display: grid;
    gap: clamp(3rem, 7vw, 7rem);
  }

  .project-story__intro {
    align-self: start;
  }

  .project-story__intro h2 {
    max-width: 13ch;
    color: var(--c-ink);
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 4.5vw, 4.4rem);
    font-weight: 450;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .project-story__intro > p:last-child {
    max-width: 34rem;
    margin-top: var(--space-6);
    color: var(--c-navy);
    font-size: clamp(1rem, 1.3vw, 1.12rem);
    line-height: 1.6;
  }

  .project-prose {
    min-width: 0;
    max-width: 48rem;
  }

  .project-prose :global(p) {
    color: var(--c-navy);
    line-height: 1.68;
  }

  .project-prose :global(p + p) {
    margin-top: var(--space-5);
  }

  .project-prose :global(h2) {
    margin-top: clamp(3rem, 6vw, 5rem);
    margin-bottom: var(--space-5);
    color: var(--c-ink);
    font-size: clamp(1.7rem, 2.7vw, 2.5rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .project-prose :global(ul) {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
    border-top: var(--border-1) solid var(--c-rule-blue);
  }

  .project-prose :global(li) {
    position: relative;
    padding: var(--space-3) 0 var(--space-3) 1.4rem;
    border-bottom: var(--border-1) solid var(--c-rule-blue);
    color: var(--c-navy);
    line-height: 1.55;
  }

  .project-prose :global(li::before) {
    content: "";
    position: absolute;
    left: 0;
    top: 1.05rem;
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 50%;
    background: var(--c-blue);
  }

  .project-prose :global(blockquote) {
    margin: clamp(2rem, 5vw, 3.5rem) 0 0;
    padding: clamp(1.5rem, 3vw, 2.25rem) 0;
    border-top: var(--border-1) solid var(--c-rule-blue);
    border-bottom: var(--border-1) solid var(--c-rule-blue);
  }

  .project-prose :global(blockquote p) {
    color: var(--c-ink);
    font-family: var(--font-display);
    font-size: clamp(1.55rem, 3vw, 2.35rem);
    font-weight: 430;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .project-gallery {
    padding-block: var(--home-section-y);
    background: var(--c-canvas-warm);
  }

  .project-gallery__frame {
    display: grid;
    gap: clamp(2.75rem, 6vw, 5rem);
  }

  .project-gallery__intro {
    display: grid;
    gap: var(--space-6);
    align-items: end;
  }

  .project-gallery__intro h2 {
    max-width: 13ch;
    color: var(--c-ink);
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 4.5vw, 4.25rem);
    font-weight: 450;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .project-gallery__intro > p {
    max-width: 32rem;
    color: var(--c-navy);
    font-size: var(--fs-2);
    line-height: var(--lh-snug);
  }

  .project-gallery__grid {
    display: grid;
    gap: clamp(1rem, 2.5vw, 2rem);
    align-items: start;
  }

  .project-gallery__grid figure {
    margin: 0;
  }

  .project-gallery__grid :global(picture),
  .project-gallery__grid :global(img) {
    width: 100%;
    display: block;
  }

  .project-gallery__grid :global(img) {
    height: auto;
    border-radius: 0.65rem;
  }

  .project-closing {
    padding-block: var(--home-section-y-tight);
    background: var(--c-canvas);
  }

  .project-closing__frame {
    display: grid;
    gap: clamp(2.5rem, 5vw, 5rem);
    padding-top: clamp(2rem, 4vw, 3.5rem);
    border-top: var(--border-1) solid var(--c-rule-blue);
  }

  .project-closing h2 {
    max-width: 12ch;
    color: var(--c-ink);
    font-size: clamp(2.4rem, 4.6vw, 4.4rem);
    font-weight: 580;
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .project-closing__content {
    max-width: 38rem;
  }

  .project-closing__content > p {
    color: var(--c-navy);
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    line-height: 1.55;
  }

  .project-closing__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    align-items: center;
    margin-top: var(--space-7);
  }

  .project-text-link {
    color: var(--c-navy);
    font-weight: 650;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .project-text-link:hover {
    color: var(--c-blue);
    text-decoration-thickness: 2px;
  }

  @media (min-width: 48rem) {
    .project-gallery__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .project-gallery__grid figure:first-child {
      grid-row: span 2;
    }
  }

  @media (min-width: 64rem) {
    .project-hero__frame {
      grid-template-columns: minmax(0, 1.2fr) minmax(20rem, 0.8fr);
    }

    .project-story__layout {
      grid-template-columns: minmax(18rem, 0.7fr) minmax(0, 1.3fr);
      align-items: start;
    }

    .project-story__intro {
      position: sticky;
      top: 8rem;
    }

    .project-gallery__intro,
    .project-closing__frame {
      grid-template-columns: minmax(0, 1.15fr) minmax(18rem, 0.85fr);
    }
  }
</style>
