---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeHero from "../components/sections/HomeHero.astro";
import finiBlueKitchen from "../assets/images/hero/fini-blue-kitchen.jpg";

import BudgetGuide from "../components/sections/BudgetGuide.astro";
import ProcessSteps from "../components/sections/ProcessSteps.astro";
import ProjectPreviewGrid from "../components/sections/ProjectPreviewGrid.astro";
import { getCollection } from "astro:content";

const allProjects = await getCollection("projects");
const featuredProjects = allProjects
  .filter((project) => project.data.featured === true)
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999))
  .slice(0, 1);

const heroImage = finiBlueKitchen;

const steps = [
  {
    title: "Initial conversation",
    body: "Understand your project, priorities, broad budget and what you need from the space.",
  },
  {
    title: "Visit our showroom",
    body: "See materials in person and begin shaping the direction.",
  },
  {
    title: "Design & specification",
    body: "Bring layout, cabinetry, finishes and practical details together.",
  },
  {
    title: "Supply & installation",
    body: "Ordering, scheduling, delivery and fitting through one coordinated plan.",
  },
  {
    title: "Follow-up & aftercare",
    body: "Resolve final details and provide support after installation.",
  },
];

---

<BaseLayout
  title="Calm, real-life kitchens | Fini’s Kitchens"
  description="Thoughtful kitchen design, supply and installation for real homes. Clear process, practical guidance and premium results without the showroom pressure."
  ogImage={heroImage.src}
  headerOverlay
  footerFlush
>
  <HomeHero image={heroImage} />

  <section id="home-content" class="real-life" aria-labelledby="real-life-title">
    <div class="container real-life__layout">
      <header class="real-life__intro">
        <p class="real-life__eyebrow">Designed for real life</p>
        <h2 id="real-life-title">Your kitchen rarely needs more… just better decisions.</h2>
        <p class="real-life__summary">
          Kitchen design should start with ordinary life - breakfast, school runs, working, hosting, family meals,
          storage, movement and the details people often forget to design around.
        </p>
      </header>

      <ol class="real-life__principles">
        <li class="real-life__principle">
          <span class="real-life__number" aria-hidden="true">01</span>
          <div>
            <h3>Style, flow and function working together</h3>
            <p>A room that looks right because it works hard.</p>
          </div>
        </li>

        <li class="real-life__principle">
          <span class="real-life__number" aria-hidden="true">02</span>
          <div>
            <h3>The little things that matter most</h3>
            <p>Storage, reach and movement considered before they become frustrations.</p>
          </div>
        </li>

        <li class="real-life__principle">
          <span class="real-life__number" aria-hidden="true">03</span>
          <div>
            <h3>The love that makes it real</h3>
            <p>Designed around the people, routines and moments that make it yours.</p>
          </div>
        </li>

        <li class="real-life__principle">
          <span class="real-life__number" aria-hidden="true">04</span>
          <div>
            <h3>Premium without the theatre</h3>
            <p>Beautiful materials and practical choices, without the showroom performance.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <BudgetGuide />

  <ProcessSteps steps={steps} />

  <ProjectPreviewGrid projects={featuredProjects} />

  <section class="calmer-way" aria-labelledby="calmer-way-title">
    <div class="container calmer-way__layout">
      <header class="calmer-way__intro">
        <p class="calmer-way__eyebrow">A calmer way to buy</p>
        <h2 id="calmer-way-title">Premium kitchens without the showroom pressure.</h2>
        <p class="calmer-way__summary">
          Clear, grounded advice and a joined-up process, from the first conversation to the finished kitchen.
        </p>
      </header>

      <div class="calmer-way__detail">
        <ul class="calmer-way__points">
          <li>Clear next steps from the outset</li>
          <li>Budget and feasibility discussed early</li>
          <li>Design decisions grounded in daily life</li>
          <li>A joined-up supply and installation journey</li>
        </ul>

        <div class="calmer-way__actions">
          <a class="btn btn--accent" href="/contact">Start a conversation</a>
          <a class="calmer-way__about-link" href="/about">Read more about Fini’s Kitchens</a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .real-life {
    padding-block: var(--home-section-y);
    color: var(--c-brand-50);
    background: var(--c-navy);
    scroll-margin-top: 6rem;
  }

  .real-life__layout {
    display: grid;
    gap: var(--home-layout-gap);
  }

  .real-life__intro {
    max-width: 34rem;
  }

  .real-life__eyebrow {
    margin-bottom: var(--space-4);
    color: var(--c-blue-pale);
    font-size: var(--eyebrow-size);
    font-weight: var(--eyebrow-weight);
    letter-spacing: var(--eyebrow-tracking);
    text-transform: uppercase;
    line-height: var(--eyebrow-line-height);
  }

  .real-life__intro h2 {
    color: #fff;
    font-family: var(--font-display);
    font-size: clamp(2.35rem, 4.4vw, 4.35rem);
    font-weight: 500;
    line-height: 1.04;
    letter-spacing: -0.022em;
    font-optical-sizing: auto;
  }

  .real-life__summary {
    margin-top: var(--space-6);
    color: rgba(255, 253, 250, 0.82);
    font-size: var(--fs-2);
    line-height: var(--lh-loose);
  }

  .real-life__principles {
    display: grid;
    gap: 0 var(--space-8);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .real-life__principle {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: var(--space-3);
    padding-block: var(--space-5) var(--space-6);
    border-top: var(--border-1) solid var(--c-rule-on-dark);
  }

  .real-life__number {
    padding-top: 0.24rem;
    color: var(--c-blue-pale);
    font-size: var(--fs-0);
    font-weight: 650;
    letter-spacing: 0.08em;
  }

  .real-life__principle h3 {
    max-width: 18ch;
    color: #fff;
    font-size: clamp(1.2rem, 1.7vw, 1.48rem);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.025em;
  }

  .real-life__principle p {
    max-width: 34ch;
    margin-top: var(--space-3);
    color: rgba(255, 253, 250, 0.82);
    font-size: var(--fs-0);
    line-height: var(--lh-snug);
  }

  .calmer-way {
    padding-block: var(--home-section-y);
    color: var(--c-brand-50);
    background: var(--c-navy);
  }

  .calmer-way__layout {
    display: grid;
    gap: var(--home-layout-gap);
  }

  .calmer-way__intro {
    max-width: 34rem;
  }

  .calmer-way__eyebrow {
    margin-bottom: var(--space-4);
    color: var(--c-blue-pale);
    font-size: var(--eyebrow-size);
    font-weight: var(--eyebrow-weight);
    letter-spacing: var(--eyebrow-tracking);
    text-transform: uppercase;
    line-height: var(--eyebrow-line-height);
  }

  .calmer-way__intro h2 {
    color: #fff;
    font-family: var(--font-display);
    font-size: clamp(2.35rem, 4.4vw, 4.35rem);
    font-weight: 500;
    line-height: 1.04;
    letter-spacing: -0.022em;
    font-optical-sizing: auto;
  }

  .calmer-way__summary {
    max-width: 35ch;
    margin-top: var(--space-6);
    color: rgba(255, 253, 250, 0.82);
    font-size: var(--fs-2);
    line-height: var(--lh-loose);
  }

  .calmer-way__detail {
    display: grid;
    gap: var(--home-layout-gap-tight);
    align-content: start;
  }

  .calmer-way__points {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .calmer-way__points li {
    position: relative;
    padding: var(--space-4) 0 var(--space-4) 1.45rem;
    border-top: var(--border-1) solid var(--c-rule-on-dark);
    color: #fff;
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    font-weight: 560;
    line-height: var(--lh-snug);
  }

  .calmer-way__points li::before {
    content: "";
    position: absolute;
    top: calc(var(--space-4) + 0.68em);
    left: 0;
    width: 0.5rem;
    height: 0.5rem;
    transform: translateY(-50%);
    border-radius: 50%;
    background: var(--c-blue-pale);
  }

  .calmer-way__points li:last-child {
    border-bottom: var(--border-1) solid var(--c-rule-on-dark);
  }

  .calmer-way__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    align-items: center;
  }

  .calmer-way__about-link {
    color: rgba(255, 253, 250, 0.82);
    font-size: var(--fs-0);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .calmer-way__about-link:hover {
    color: #fff;
    text-decoration-thickness: 2px;
  }

  .calmer-way__about-link:focus-visible {
    outline-color: var(--c-brand-200);
    outline-offset: 5px;
  }

  @media (min-width: 48rem) {
    .real-life__layout {
      grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
      align-items: start;
    }

    .calmer-way__layout {
      grid-template-columns: minmax(0, 0.86fr) minmax(22rem, 1.14fr);
      align-items: start;
    }

  }

  @media (min-width: 72rem) {
    .real-life__principles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .real-life__principle:nth-child(even) {
      margin-top: clamp(1.5rem, 3vw, 3rem);
    }
  }
</style>
