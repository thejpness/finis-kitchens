---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeHero from "../components/sections/HomeHero.astro";
import finiBlueKitchen from "../assets/images/hero/fini-blue-kitchen.jpg";

import BudgetGuide from "../components/sections/BudgetGuide.astro";
import ProcessSteps from "../components/sections/ProcessSteps.astro";
import ProjectPreviewGrid from "../components/sections/ProjectPreviewGrid.astro";
import FAQList from "../components/sections/FAQList.astro";
import { getCollection } from "astro:content";

const allProjects = await getCollection("projects");
const featuredProjects = allProjects
  .filter((project) => project.data.featured === true)
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999))
  .slice(0, 3);

const heroImage = finiBlueKitchen;

const steps = [
  {
    title: "Initial conversation",
    body: "Understand your project, priorities, broad budget and what you need from the space.",
  },
  {
    title: "Visit our showroom",
    body: "See materials in person and begin shaping the direction.",
  },
  {
    title: "Design & specification",
    body: "Bring layout, cabinetry, finishes and practical details together.",
  },
  {
    title: "Supply & installation",
    body: "Ordering, scheduling, delivery and fitting through one coordinated plan.",
  },
  {
    title: "Follow-up & aftercare",
    body: "Resolve final details and provide support after installation.",
  },
];

const faqs = [
  {
    question: "How much should we budget for a new kitchen?",
    answer:
      "That depends on the size of the room, your cabinetry choices, worktops, appliances and whether any building work sits around the kitchen itself. We aim to give you useful cost guidance early, so you can make decisions with confidence.",
  },
  {
    question: "How long does a typical project take?",
    answer:
      "Many projects take around three months from initial design through to installation. Exact timings depend on the scope of work, product choices and the room itself.",
  },
  {
    question: "Do you handle installation as well as design?",
    answer:
      "Yes. Fini’s Kitchens offers a joined-up service covering design, supply and installation, so the process feels clearer and better coordinated.",
  },
  {
    question: "Will the process feel very sales-led?",
    answer:
      "No. The approach is designed to feel calm, clear and low pressure, with practical advice and straightforward conversations rather than pushy selling.",
  },
  {
    question: "Do you only work on large, high-end projects?",
    answer:
      "Not at all. The focus is on thoughtful, well-planned kitchens for real homes - with quality and care in the details, without unnecessary showroom drama.",
  },
];
---

<BaseLayout
  title="Calm, real-life kitchens | Fini’s Kitchens"
  description="Thoughtful kitchen design, supply and installation for real homes. Clear process, practical guidance and premium results without the showroom pressure."
  ogImage={heroImage.src}
  headerOverlay
>
  <HomeHero image={heroImage} />

  <section id="home-content" class="real-life" aria-labelledby="real-life-title">
    <div class="container real-life__layout">
      <header class="real-life__intro">
        <p class="real-life__eyebrow">Designed for real life</p>
        <h2 id="real-life-title">Your kitchen rarely needs more… just better decisions.</h2>
        <p class="real-life__summary">
          Kitchen design should start with ordinary life — breakfast, school runs, working, hosting, family meals,
          storage, movement and the details people often forget to design around.
        </p>
      </header>

      <ol class="real-life__principles">
        <li class="real-life__principle">
          <span class="real-life__number" aria-hidden="true">01</span>
          <div>
            <h3>Style, flow and function working together</h3>
            <p>A room that looks right because it works hard.</p>
          </div>
        </li>

        <li class="real-life__principle">
          <span class="real-life__number" aria-hidden="true">02</span>
          <div>
            <h3>The little things that matter most</h3>
            <p>Storage, reach and movement considered before they become frustrations.</p>
          </div>
        </li>

        <li class="real-life__principle">
          <span class="real-life__number" aria-hidden="true">03</span>
          <div>
            <h3>The love that makes it real</h3>
            <p>Designed around the people, routines and moments that make it yours.</p>
          </div>
        </li>

        <li class="real-life__principle">
          <span class="real-life__number" aria-hidden="true">04</span>
          <div>
            <h3>Premium without the theatre</h3>
            <p>Beautiful materials and practical choices, without the showroom performance.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <BudgetGuide />

  <ProcessSteps steps={steps} />

  <ProjectPreviewGrid projects={featuredProjects} />

  <section class="section section--tight">
    <div class="container">
      <div class="founder-panel">
        <div class="stack stack--tight">
          <p class="eyebrow">A calmer way to buy</p>
          <h2>Low pressure is not just a tone of voice. It is built into the process.</h2>
        </div>

        <div class="founder-panel__body stack stack--tight">
          <p class="muted text-measure">
            From the first conversation to the finished kitchen, the aim is to make the process feel clear,
            grounded and easier to trust - with practical advice, honest guidance and attention to how the room will really be used.
          </p>

          <ul class="check-list" role="list">
            <li>Clear next steps from the outset</li>
            <li>Budget and feasibility discussed early</li>
            <li>Design decisions grounded in daily life</li>
            <li>A joined-up supply and installation journey</li>
          </ul>

          <div class="cta-row">
            <a class="btn btn--primary" href="/contact">Book a call</a>
            <a class="text-link" href="/about">Read more about Fini’s Kitchens</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container section-frame stack stack--loose">
      <header class="section-intro">
        <div class="stack stack--tight">
          <p class="eyebrow">Reassurance</p>
          <h2>The questions most people want answered early.</h2>
        </div>
      </header>

      <div class="trust-grid">
        <article class="card card--surface trust-card">
          <h3>What kind of budget is realistic?</h3>
          <p class="muted">
            Early cost guidance helps you understand what is possible and plan with more confidence.
          </p>
        </article>

        <article class="card card--surface trust-card">
          <h3>How long is this likely to take?</h3>
          <p class="muted">
            Clear expectations around timings make the whole experience feel calmer and easier to manage.
          </p>
        </article>

        <article class="card card--surface trust-card">
          <h3>Who is handling installation?</h3>
          <p class="muted">
            Knowing how the project is coordinated gives you more confidence from the outset.
          </p>
        </article>
      </div>
    </div>
  </section>

  <FAQList items={faqs} />

  <section class="section">
    <div class="container">
      <div class="final-cta">
        <div class="stack stack--tight">
          <p class="eyebrow">Start simply</p>
          <h2>Start with a conversation, not a sales script.</h2>
          <p class="muted text-measure">
            If you are planning a new kitchen and want clear, grounded advice, the first step is a calm conversation about your home, your priorities and your budget.
          </p>
        </div>

        <div class="cta-row">
          <a class="btn btn--primary btn--large" href="/contact">Book a design call</a>
          <a class="btn btn--secondary btn--large" href="#budgets">See typical project budgets</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .trust-grid {
    display: grid;
    gap: var(--space-6);
  }

  .trust-card h3 {
    margin-bottom: var(--space-3);
  }

  .real-life {
    padding-block: clamp(4.5rem, 9vw, 8rem);
    color: var(--c-brand-50);
    background: var(--c-brand-900);
    scroll-margin-top: 6rem;
  }

  .real-life__layout {
    display: grid;
    gap: clamp(3.5rem, 7vw, 7rem);
  }

  .real-life__intro {
    max-width: 34rem;
  }

  .real-life__eyebrow {
    margin-bottom: var(--space-4);
    color: var(--c-brand-300);
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
  }

  .real-life__intro h2 {
    color: #fff;
    font-size: clamp(2.35rem, 4.4vw, 4.35rem);
    font-weight: 580;
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .real-life__summary {
    margin-top: var(--space-6);
    color: var(--c-brand-100);
    font-size: var(--fs-2);
    line-height: var(--lh-loose);
  }

  .real-life__principles {
    display: grid;
    gap: 0 var(--space-8);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .real-life__principle {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: var(--space-3);
    padding-block: var(--space-6) var(--space-7);
    border-top: 1px solid rgba(185, 208, 239, 0.32);
  }

  .real-life__number {
    padding-top: 0.24rem;
    color: var(--c-brand-300);
    font-size: var(--fs-0);
    font-weight: 650;
    letter-spacing: 0.08em;
  }

  .real-life__principle h3 {
    max-width: 18ch;
    color: #fff;
    font-size: clamp(1.2rem, 1.7vw, 1.48rem);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.025em;
  }

  .real-life__principle p {
    max-width: 34ch;
    margin-top: var(--space-3);
    color: var(--c-brand-100);
    font-size: var(--fs-0);
    line-height: var(--lh-snug);
  }

  .founder-panel {
    display: grid;
    gap: var(--space-7);
    padding: var(--space-8);
    border: var(--border-1) solid var(--c-border);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(circle at top left, rgba(157, 184, 233, 0.18) 0%, rgba(157, 184, 233, 0) 42%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.94) 0%, rgba(246, 241, 234, 0.94) 100%);
    box-shadow: var(--shadow-2);
  }

  .final-cta {
    display: grid;
    gap: var(--space-6);
    padding: var(--space-8);
    border-radius: var(--radius-xl);
    border: var(--border-1) solid var(--c-border);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.96) 0%, rgba(246, 241, 234, 0.94) 100%);
    box-shadow: var(--shadow-1);
  }

  @media (min-width: 48rem) {
    .trust-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .real-life__layout {
      grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
      align-items: start;
    }

    .real-life__principles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .real-life__principle:nth-child(even) {
      margin-top: clamp(2.5rem, 6vw, 4.75rem);
    }

    .founder-panel {
      grid-template-columns: 0.9fr 1.1fr;
      align-items: start;
    }

    .final-cta {
      grid-template-columns: 1fr auto;
      align-items: center;
    }
  }
</style>
