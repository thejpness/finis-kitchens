---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeHero from "../components/sections/HomeHero.astro";
import ProofStrip from "../components/sections/ProofStrip.astro";
import BudgetGuide from "../components/sections/BudgetGuide.astro";
import ProcessSteps from "../components/sections/ProcessSteps.astro";
import ProjectPreviewGrid from "../components/sections/ProjectPreviewGrid.astro";
import FAQList from "../components/sections/FAQList.astro";
import { getCollection } from "astro:content";

import phWide from "../assets/images/placeholders/kitchen-placeholder-wide-island.png";

const allProjects = await getCollection("projects");
const featuredProjects = allProjects
  .filter((project) => project.data.featured === true)
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999))
  .slice(0, 3);

const heroImage = featuredProjects[0]?.data.heroImage ?? phWide;

const proofItems = [
  {
    title: "Designed around real routines",
    text: "Storage, prep space, movement and everyday family life considered from the start.",
  },
  {
    title: "A calmer process",
    text: "Clear communication, practical guidance and a more straightforward way to buy a kitchen.",
  },
  {
    title: "Budget guidance early",
    text: "Useful cost direction upfront, so you can plan with more confidence.",
  },
  {
    title: "Real homes, real results",
    text: "Kitchens created for lived-in spaces, not showroom theatre.",
  },
];

const steps = [
  {
    title: "Home survey and brief",
    body: "We start by understanding your room, your routines and what you want the kitchen to do better every day.",
  },
  {
    title: "Layout and design direction",
    body: "We shape the layout around flow, storage, appliances and the details that make the space feel easier to use.",
  },
  {
    title: "Specification and sign-off",
    body: "Cabinetry, finishes, worktops and practical details are refined until everything feels considered and right.",
  },
  {
    title: "Supply and installation",
    body: "Your project moves through to delivery and fitting with a clear plan and less chasing from you.",
  },
];

const faqs = [
  {
    question: "How much should we budget for a new kitchen?",
    answer:
      "That depends on the size of the room, your cabinetry choices, worktops, appliances and whether any building work sits around the kitchen itself. We aim to give you useful cost guidance early, so you can make decisions with confidence.",
  },
  {
    question: "How long does a typical project take?",
    answer:
      "Many projects take around three months from initial design through to installation. Exact timings depend on the scope of work, product choices and the room itself.",
  },
  {
    question: "Do you handle installation as well as design?",
    answer:
      "Yes. Fini’s Kitchens offers a joined-up service covering design, supply and installation, so the process feels clearer and better coordinated.",
  },
  {
    question: "Will the process feel very sales-led?",
    answer:
      "No. The approach is designed to feel calm, clear and low pressure, with practical advice and straightforward conversations rather than pushy selling.",
  },
  {
    question: "Do you only work on large, high-end projects?",
    answer:
      "Not at all. The focus is on thoughtful, well-planned kitchens for real homes - with quality and care in the details, without unnecessary showroom drama.",
  },
];
---

<BaseLayout
  title="Calm, real-life kitchens | Fini’s Kitchens"
  description="Thoughtful kitchen design, supply and installation for real homes. Clear process, practical guidance and premium results without the showroom pressure."
  ogImage={heroImage.src}
>
  <HomeHero image={heroImage} />

  <ProofStrip items={proofItems} />

  <section class="section section--tight">
    <div class="container section-frame stack stack--loose">
      <header class="section-intro">
        <div class="stack stack--tight">
          <p class="eyebrow">Designed for real life</p>
          <h2>A calm kitchen is rarely about more units. It is about better decisions.</h2>
        </div>
        <p class="muted text-measure">
          Good kitchen design starts with everyday life - weekday breakfasts, school bags, quiet evenings,
          hosting friends, finding space for everything, and making the room feel easier to use.
        </p>
      </header>

      <div class="home-value__grid">
        <article class="card card--surface home-value__card">
          <h3>Flow before features</h3>
          <p class="muted">
            Prep space, routes through the room, bin placement, appliance positioning and everyday reach matter
            just as much as the final look.
          </p>
        </article>

        <article class="card card--surface home-value__card">
          <h3>Premium without the theatre</h3>
          <p class="muted">
            Quality comes through in the fit, finish and thought behind the design - not in vague luxury language.
          </p>
        </article>

        <article class="card card--surface home-value__card">
          <h3>Clarity builds confidence</h3>
          <p class="muted">
            Understanding likely budgets, timings and installation scope early makes the whole project feel more settled.
          </p>
        </article>
      </div>
    </div>
  </section>

  <BudgetGuide />

  <ProcessSteps steps={steps} />

  <section class="section section--tight">
    <div class="container section-frame stack stack--loose">
      <header class="section-intro">
        <div class="stack stack--tight">
          <p class="eyebrow">Why it matters</p>
          <h2>The kitchen should work better on a normal day, not just look good in photographs.</h2>
        </div>
        <p class="muted text-measure">
          A well-planned kitchen should feel easier, calmer and more natural to live with from the moment you start using it.
        </p>
      </header>

      <div class="home-lifestyle__grid">
        <article class="home-lifestyle__feature home-lifestyle__feature--large">
          <p class="eyebrow">For busy families</p>
          <h3>Better flow. Better storage. Less friction.</h3>
          <p class="muted">
            Create space for packed lunches, homework spillover, family dinners and the half-chaos of ordinary evenings
            without the room feeling overloaded.
          </p>
        </article>

        <article class="home-lifestyle__feature">
          <p class="eyebrow">For long-term homeowners</p>
          <h3>A kitchen you can live with for years</h3>
          <p class="muted">
            Thoughtful choices in layout, materials and finish help the room feel right now and still feel right later.
          </p>
        </article>

        <article class="home-lifestyle__feature">
          <p class="eyebrow">For downsizers or renovators</p>
          <h3>Make every inch work harder</h3>
          <p class="muted">
            Smaller rooms and reworked spaces need sharper planning, smart storage and careful use of every corner.
          </p>
        </article>
      </div>
    </div>
  </section>

  <ProjectPreviewGrid projects={featuredProjects} />

  <section class="section section--tight">
    <div class="container">
      <div class="founder-panel">
        <div class="stack stack--tight">
          <p class="eyebrow">A calmer way to buy</p>
          <h2>Low pressure is not just a tone of voice. It is built into the process.</h2>
        </div>

        <div class="founder-panel__body stack stack--tight">
          <p class="muted text-measure">
            From the first conversation to the finished kitchen, the aim is to make the process feel clear,
            grounded and easier to trust - with practical advice, honest guidance and attention to how the room will really be used.
          </p>

          <ul class="check-list" role="list">
            <li>Clear next steps from the outset</li>
            <li>Budget and feasibility discussed early</li>
            <li>Design decisions grounded in daily life</li>
            <li>A joined-up supply and installation journey</li>
          </ul>

          <div class="cta-row">
            <a class="btn btn--primary" href="/contact">Book a call</a>
            <a class="text-link" href="/about">Read more about Fini’s Kitchens</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container section-frame stack stack--loose">
      <header class="section-intro">
        <div class="stack stack--tight">
          <p class="eyebrow">Reassurance</p>
          <h2>The questions most people want answered early.</h2>
        </div>
      </header>

      <div class="trust-grid">
        <article class="card card--surface trust-card">
          <h3>What kind of budget is realistic?</h3>
          <p class="muted">
            Early cost guidance helps you understand what is possible and plan with more confidence.
          </p>
        </article>

        <article class="card card--surface trust-card">
          <h3>How long is this likely to take?</h3>
          <p class="muted">
            Clear expectations around timings make the whole experience feel calmer and easier to manage.
          </p>
        </article>

        <article class="card card--surface trust-card">
          <h3>Who is handling installation?</h3>
          <p class="muted">
            Knowing how the project is coordinated gives you more confidence from the outset.
          </p>
        </article>
      </div>
    </div>
  </section>

  <FAQList items={faqs} />

  <section class="section">
    <div class="container">
      <div class="final-cta">
        <div class="stack stack--tight">
          <p class="eyebrow">Start simply</p>
          <h2>Start with a conversation, not a sales script.</h2>
          <p class="muted text-measure">
            If you are planning a new kitchen and want clear, grounded advice, the first step is a calm conversation about your home, your priorities and your budget.
          </p>
        </div>

        <div class="cta-row">
          <a class="btn btn--primary btn--large" href="/contact">Book a design call</a>
          <a class="btn btn--secondary btn--large" href="#budgets">See typical project budgets</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-value__grid,
  .home-lifestyle__grid,
  .trust-grid {
    display: grid;
    gap: var(--space-6);
  }

  .home-value__card h3,
  .trust-card h3 {
    margin-bottom: var(--space-3);
  }

  .home-lifestyle__feature {
    padding: var(--space-7);
    border: var(--border-1) solid var(--c-border);
    border-radius: var(--radius-xl);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.96) 0%, rgba(246, 241, 234, 0.92) 100%);
    box-shadow: var(--shadow-1);
  }

  .home-lifestyle__feature h3 {
    margin-top: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .founder-panel {
    display: grid;
    gap: var(--space-7);
    padding: var(--space-8);
    border: var(--border-1) solid var(--c-border);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(circle at top left, rgba(157, 184, 233, 0.18) 0%, rgba(157, 184, 233, 0) 42%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.94) 0%, rgba(246, 241, 234, 0.94) 100%);
    box-shadow: var(--shadow-2);
  }

  .final-cta {
    display: grid;
    gap: var(--space-6);
    padding: var(--space-8);
    border-radius: var(--radius-xl);
    border: var(--border-1) solid var(--c-border);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.96) 0%, rgba(246, 241, 234, 0.94) 100%);
    box-shadow: var(--shadow-1);
  }

  @media (min-width: 48rem) {
    .home-value__grid,
    .trust-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .home-lifestyle__grid {
      grid-template-columns: 1.4fr 1fr 1fr;
      align-items: stretch;
    }

    .home-lifestyle__feature--large {
      grid-row: 1 / span 2;
    }

    .founder-panel {
      grid-template-columns: 0.9fr 1.1fr;
      align-items: start;
    }

    .final-cta {
      grid-template-columns: 1fr auto;
      align-items: center;
    }
  }
</style>