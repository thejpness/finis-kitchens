---
// src/pages/process.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import FAQList from "../components/sections/FAQList.astro";
import phWide from "../assets/images/placeholders/kitchen-placeholder-wide-island.png";

const processPromises = [
  {
    title: "Clarity early",
    text:
      "Likely scope, budget direction and next steps are discussed early, so you know where you stand before the detail begins.",
  },
  {
    title: "Designed around real life",
    text:
      "Layout and specification are grounded in movement, storage, appliances and the way your household actually uses the room.",
  },
  {
    title: "Joined-up delivery",
    text:
      "Design, supply and installation are treated as one coordinated journey, with practical communication throughout.",
  },
  {
    title: "Support after fitting",
    text:
      "Aftercare is part of the process, so final details and questions are not left hanging once installation is complete.",
  },
];

const stages = [
  {
    number: "01",
    title: "Initial conversation",
    intro:
      "We start with a straightforward conversation about your home, your priorities, your broad budget and what you need the kitchen to do better.",
    points: [
      "Talk through the room, your priorities and the frustrations you want to solve",
      "Discuss style, function, appliances and everyday routines",
      "Sense-check likely scope, feasibility and investment level early",
    ],
  },
  {
    number: "02",
    title: "Visit our showroom",
    intro:
      "The showroom gives you a chance to see and handle materials in person, compare options and begin shaping a direction that feels right for your home.",
    points: [
      "See cabinetry, worktops, finishes and practical details in person",
      "Explore the styles and combinations that suit your space",
      "Refine the direction before detailed design work begins",
    ],
  },
  {
    number: "03",
    title: "Design & specification",
    intro:
      "With a clear direction established, the room is properly understood and the design is developed around flow, storage, materials and the way you actually live.",
    points: [
      "Survey the room and understand its practical constraints",
      "Shape the layout around movement, preparation, storage and appliances",
      "Finalise cabinetry, worktops, finishes and the agreed project specification",
    ],
  },
  {
    number: "04",
    title: "Supply & installation",
    intro:
      "Once the design is agreed, ordering, scheduling, delivery and fitting move forward as one coordinated stage with clear communication throughout.",
    points: [
      "Confirm orders, timings and the installation plan",
      "Coordinate supply, delivery and fitting",
      "Keep progress and next steps clear as the kitchen comes together",
    ],
  },
  {
    number: "05",
    title: "Follow-up & aftercare",
    intro:
      "The relationship does not stop when the fitting finishes. Final details are checked, questions are resolved and support remains available afterwards.",
    points: [
      "Review the finished kitchen and resolve any final details",
      "Make sure everything is working as expected",
      "Provide practical support after installation where needed",
    ],
  },
];

const faqs = [
  {
    question: "How much should we budget before speaking to you?",
    answer:
      "A rough figure is enough to start. The aim is not to force precision too early, but to understand the kind of project you are considering and give useful guidance as the brief becomes clearer.",
  },
  {
    question: "How long does the full process usually take?",
    answer:
      "Many projects take around three months from initial design through to installation, though timings depend on the scope of work, the room itself and the choices made during specification.",
  },
  {
    question: "Will we be pushed into decisions quickly?",
    answer:
      "No. The process is intended to feel calm and clear. Important decisions are made in sequence, with sensible guidance, rather than being rushed through in a sales-led way.",
  },
  {
    question: "Do you handle installation as well as design?",
    answer:
      "Yes. Fini’s Kitchens offers a joined-up design, supply and installation service so the project feels more coordinated from start to finish.",
  },
  {
    question: "Is this only for very large or high-end projects?",
    answer:
      "No. The focus is on thoughtful, well-planned kitchens for real homes. Quality matters, but so does practicality, clarity and making the room work properly for everyday life.",
  },
];
---

<BaseLayout
  title="Our process | Fini’s Kitchens"
  description="A calm, clear kitchen process from first conversation to aftercare. Thoughtful design, practical guidance and joined-up installation for real homes."
  ogImage={phWide.src}
>
  <section class="process-page-hero">
    <div class="container process-page-hero__layout">
      <div class="process-page-hero__copy">
        <p class="process-page-hero__eyebrow">How it works</p>
        <h1>A clear kitchen process from first conversation to aftercare.</h1>
        <p class="process-page-hero__summary">
          The right decisions, in the right order - with practical guidance, early budget conversations
          and a joined-up route from design through installation and aftercare.
        </p>

        <div class="process-page-hero__actions">
          <a class="btn btn--primary btn--large" href="/contact">Start a conversation</a>
          <a class="process-page-hero__budget-link" href="/#budgets">View indicative budgets</a>
        </div>
      </div>

      <aside class="process-page-hero__guide" aria-label="What you can expect from the process">
        <p class="process-page-hero__guide-label">Throughout the journey</p>
        <ul>
          <li>Budget and feasibility discussed early</li>
          <li>Design grounded in the way you actually live</li>
          <li>Clear decisions without showroom pressure</li>
          <li>Supply and installation coordinated together</li>
          <li>Support that continues after fitting</li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="process-journey" aria-labelledby="process-journey-title">
    <div class="container process-journey__frame">
      <header class="process-journey__intro">
        <div>
          <p class="process-journey__eyebrow">Step by step</p>
          <h2 id="process-journey-title">Five clear stages, from first conversation to aftercare.</h2>
        </div>

        <p class="process-journey__summary">
          Every project is slightly different, but the structure keeps decisions in the right order
          and makes it clear what happens next.
        </p>
      </header>

      <ol class="process-journey__list">
        {stages.map((stage) => (
          <li class="process-journey__stage">
            <p class="process-journey__number" aria-hidden="true">{stage.number}</p>

            <h3>{stage.title}</h3>

            <div class="process-journey__detail">
              <p class="process-journey__stage-intro">{stage.intro}</p>

              <ul>
                {stage.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="process-reassurance" aria-labelledby="process-reassurance-title">
    <div class="container process-reassurance__frame">
      <header class="process-reassurance__intro">
        <div>
          <p class="process-reassurance__eyebrow">Built into every stage</p>
          <h2 id="process-reassurance-title">Clear decisions, made in the right order.</h2>
        </div>

        <p class="process-reassurance__summary">
          You should always understand what is being decided, why it matters and what happens next.
          The process is designed to keep the project practical, considered and easier to trust.
        </p>
      </header>

      <div class="process-reassurance__grid">
        {processPromises.map((item, index) => (
          <article class="process-reassurance__item">
            <p class="process-reassurance__number" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </p>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <FAQList items={faqs} />

  <section class="process-closing" aria-labelledby="process-closing-title">
    <div class="container">
      <div class="process-closing__frame">
        <div>
          <p class="process-closing__eyebrow">Ready when you are</p>
          <h2 id="process-closing-title">Start with a conversation.</h2>
        </div>

        <div class="process-closing__content">
          <p>
            Tell us about your home, your priorities and what you want the kitchen to do better.
            We can take it from there.
          </p>

          <div class="process-closing__actions">
            <a class="btn btn--primary btn--large" href="/contact">Start a conversation</a>
            <a class="process-closing__link" href="/projects">See finished kitchens</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .process-page-hero {
    padding-block: clamp(4rem, 7vw, 6.25rem);
    background: var(--c-canvas-warm);
  }

  .process-page-hero__layout {
    display: grid;
    gap: clamp(3rem, 7vw, 7rem);
    align-items: end;
  }

  .process-page-hero__copy {
    max-width: 46rem;
  }

  .process-page-hero__eyebrow,
  .process-page-hero__guide-label {
    color: var(--c-blue);
    font-size: var(--eyebrow-size);
    font-weight: var(--eyebrow-weight);
    line-height: var(--eyebrow-line-height);
    letter-spacing: var(--eyebrow-tracking);
    text-transform: uppercase;
  }

  .process-page-hero__eyebrow {
    margin-bottom: var(--space-4);
  }

  .process-page-hero h1 {
    max-width: 12ch;
    color: var(--c-ink);
    font-family: var(--font-display);
    font-size: clamp(3rem, 6vw, 5.8rem);
    font-weight: 450;
    line-height: 0.98;
    letter-spacing: -0.035em;
  }

  .process-page-hero__summary {
    max-width: 42rem;
    margin-top: var(--space-6);
    color: var(--c-navy);
    font-size: clamp(1.08rem, 1.7vw, 1.3rem);
    line-height: var(--lh-snug);
  }

  .process-page-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    align-items: center;
    margin-top: var(--space-7);
  }

  .process-page-hero__budget-link {
    color: var(--c-navy);
    font-size: var(--fs-0);
    font-weight: 650;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .process-page-hero__budget-link:hover {
    color: var(--c-blue);
    text-decoration-thickness: 2px;
  }

  .process-page-hero__guide {
    padding-top: var(--space-5);
    border-top: var(--border-1) solid var(--c-rule-blue);
  }

  .process-page-hero__guide ul {
    padding: 0;
    margin: var(--space-5) 0 0;
    list-style: none;
  }

  .process-page-hero__guide li {
    padding-block: var(--space-4);
    border-top: var(--border-1) solid var(--c-rule-blue);
    color: var(--c-ink);
    font-size: clamp(1rem, 1.3vw, 1.12rem);
    font-weight: 560;
    line-height: var(--lh-snug);
  }

  .process-page-hero__guide li:last-child {
    border-bottom: var(--border-1) solid var(--c-rule-blue);
  }

  .process-journey {
    padding-block: var(--home-section-y);
    border-top: var(--border-1) solid var(--c-rule-blue);
    background: var(--c-paper);
  }

  .process-journey__frame {
    display: grid;
    gap: clamp(2.75rem, 5vw, 4.5rem);
  }

  .process-journey__intro {
    display: grid;
    gap: var(--space-6);
    align-items: end;
  }

  .process-journey__eyebrow {
    margin-bottom: var(--space-4);
    color: var(--c-blue);
    font-size: var(--eyebrow-size);
    font-weight: var(--eyebrow-weight);
    line-height: var(--eyebrow-line-height);
    letter-spacing: var(--eyebrow-tracking);
    text-transform: uppercase;
  }

  .process-journey__intro h2 {
    max-width: 15ch;
    color: var(--c-ink);
    font-size: clamp(2.35rem, 4.4vw, 4.35rem);
    font-weight: 580;
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .process-journey__summary {
    max-width: 34ch;
    color: var(--c-navy);
    font-size: var(--fs-2);
    line-height: var(--lh-snug);
  }

  .process-journey__list {
    padding: 0;
    margin: 0;
    list-style: none;
    border-top: var(--border-1) solid var(--c-rule-blue);
  }

  .process-journey__stage {
    display: grid;
    gap: var(--space-5);
    padding-block: clamp(2rem, 4vw, 3.25rem);
    border-bottom: var(--border-1) solid var(--c-rule-blue);
  }

  .process-journey__number {
    color: var(--c-blue);
    font-size: clamp(2.2rem, 3.4vw, 3.25rem);
    font-weight: 580;
    line-height: 0.9;
    letter-spacing: -0.05em;
  }

  .process-journey__stage h3 {
    max-width: 16ch;
    color: var(--c-ink);
    font-size: clamp(1.55rem, 2.5vw, 2.35rem);
    font-weight: 580;
    line-height: 1.04;
    letter-spacing: -0.035em;
  }

  .process-journey__detail {
    max-width: 42rem;
  }

  .process-journey__stage-intro {
    color: var(--c-navy);
    font-size: clamp(1rem, 1.25vw, 1.1rem);
    line-height: 1.55;
  }

  .process-journey__detail ul {
    padding: 0;
    margin: var(--space-6) 0 0;
    list-style: none;
    border-top: var(--border-1) solid var(--c-rule-blue);
  }

  .process-journey__detail li {
    padding-block: var(--space-3);
    border-bottom: var(--border-1) solid var(--c-rule-blue);
    color: var(--c-text-muted);
    font-size: var(--fs-0);
    line-height: var(--lh-snug);
  }

  .process-reassurance {
    padding-block: var(--home-section-y);
    background: var(--c-navy);
    color: var(--c-paper);
  }

  .process-reassurance__frame {
    display: grid;
    gap: clamp(3rem, 6vw, 5rem);
  }

  .process-reassurance__intro {
    display: grid;
    gap: var(--space-6);
    align-items: end;
  }

  .process-reassurance__eyebrow {
    margin-bottom: var(--space-4);
    color: var(--c-blue-pale);
    font-size: var(--eyebrow-size);
    font-weight: var(--eyebrow-weight);
    line-height: var(--eyebrow-line-height);
    letter-spacing: var(--eyebrow-tracking);
    text-transform: uppercase;
  }

  .process-reassurance__intro h2 {
    max-width: 13ch;
    color: var(--c-paper);
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 4.6vw, 4.5rem);
    font-weight: 450;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .process-reassurance__summary {
    max-width: 36ch;
    color: var(--c-blue-pale);
    font-size: var(--fs-2);
    line-height: var(--lh-snug);
  }

  .process-reassurance__grid {
    display: grid;
    border-top: var(--border-1) solid var(--c-rule-on-dark);
  }

  .process-reassurance__item {
    padding-block: clamp(1.75rem, 3vw, 2.5rem);
    border-bottom: var(--border-1) solid var(--c-rule-on-dark);
  }

  .process-reassurance__number {
    margin-bottom: var(--space-5);
    color: var(--c-blue-pale);
    font-size: var(--fs--1);
    font-weight: 650;
    letter-spacing: 0.12em;
  }

  .process-reassurance__item h3 {
    margin-bottom: var(--space-3);
    color: var(--c-paper);
    font-size: clamp(1.35rem, 2vw, 1.75rem);
    font-weight: 580;
    line-height: 1.05;
    letter-spacing: -0.025em;
  }

  .process-reassurance__item > p:last-child {
    max-width: 34rem;
    color: var(--c-blue-pale);
    line-height: 1.55;
  }

  .process-closing {
    padding-block: var(--home-section-y);
    background: var(--c-canvas);
  }

  .process-closing__frame {
    display: grid;
    gap: clamp(2.5rem, 5vw, 5rem);
    padding-top: clamp(2rem, 4vw, 3.5rem);
    border-top: var(--border-1) solid var(--c-rule-blue);
  }

  .process-closing__eyebrow {
    margin-bottom: var(--space-4);
    color: var(--c-blue);
    font-size: var(--eyebrow-size);
    font-weight: var(--eyebrow-weight);
    line-height: var(--eyebrow-line-height);
    letter-spacing: var(--eyebrow-tracking);
    text-transform: uppercase;
  }

  .process-closing h2 {
    max-width: 10ch;
    color: var(--c-ink);
    font-size: clamp(2.5rem, 4.8vw, 4.6rem);
    font-weight: 580;
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .process-closing__content {
    max-width: 38rem;
  }

  .process-closing__content > p {
    color: var(--c-navy);
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    line-height: 1.55;
  }

  .process-closing__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    align-items: center;
    margin-top: var(--space-7);
  }

  .process-closing__link {
    color: var(--c-navy);
    font-weight: 650;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .process-closing__link:hover {
    color: var(--c-blue);
    text-decoration-thickness: 2px;
  }

  @media (min-width: 48rem) {
    .process-journey__intro,
    .process-reassurance__intro {
      grid-template-columns: minmax(0, 1.15fr) minmax(16rem, 0.85fr);
    }

    .process-journey__stage {
      grid-template-columns: minmax(3.5rem, 0.16fr) minmax(0, 1fr);
      column-gap: clamp(1.75rem, 4vw, 3rem);
    }

    .process-journey__detail {
      grid-column: 2;
    }

    .process-reassurance__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .process-reassurance__item {
      padding-inline: clamp(1.5rem, 3vw, 2.5rem);
    }

    .process-reassurance__item:nth-child(odd) {
      padding-left: 0;
      border-right: var(--border-1) solid var(--c-rule-on-dark);
    }

    .process-reassurance__item:nth-child(even) {
      padding-right: 0;
    }
  }

  @media (min-width: 64rem) {
    .process-page-hero__layout {
      grid-template-columns: minmax(0, 1.25fr) minmax(20rem, 0.75fr);
    }

    .process-journey__stage {
      grid-template-columns:
        minmax(3.5rem, 0.18fr)
        minmax(13rem, 0.62fr)
        minmax(0, 1.2fr);
      gap: clamp(2rem, 4vw, 4.5rem);
      align-items: start;
    }

    .process-journey__detail {
      grid-column: auto;
    }

    .process-closing__frame {
      grid-template-columns: minmax(0, 1fr) minmax(20rem, 0.8fr);
      align-items: start;
    }
  }

  @media (min-width: 72rem) {
    .process-reassurance__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .process-reassurance__item {
      padding-inline: clamp(1.5rem, 2.5vw, 2.5rem);
      border-right: var(--border-1) solid var(--c-rule-on-dark);
    }

    .process-reassurance__item:first-child {
      padding-left: 0;
    }

    .process-reassurance__item:last-child {
      padding-right: 0;
      border-right: 0;
    }
  }
</style>