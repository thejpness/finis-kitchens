---
// src/components/Header.astro

interface Props {
  overlay?: boolean;
}

const { overlay = false } = Astro.props as Props;

const navItems = [
  { href: "/", label: "Home" },
  { href: "/process", label: "Process" },
  { href: "/projects", label: "Case studies" },
  { href: "/the-love-that-stays", label: "Fini's Story" },
  { href: "/about", label: "About" },
];

const pathname = Astro.url?.pathname ?? "/";

const isActive = (href: string) => {
  if (href === "/") return pathname === "/";
  return pathname === href || pathname.startsWith(href + "/");
};

const contactActive = isActive("/contact");
---

<a class="skip-link" href="#main">Skip to content</a>

<header class:list={["site-header", overlay && "site-header--hero", overlay && "is-top"]} data-header>
  <div class="site-header__inner container">
    <a href="/" class="site-header__brand" aria-label="Fini's Kitchens home">
      <span class="site-header__brand-mark-wrap" aria-hidden="true">
        <img
          class="site-header__brand-mark"
          src="/images/logo-icon-blue.svg"
          alt=""
          width="96"
          height="96"
          decoding="async"
        />
      </span>

      <span class="site-header__brand-copy">
        <span class="site-header__brand-name">Fini’s Kitchens</span>
        <span class="site-header__brand-tag">For the Family</span>
      </span>
    </a>

    <button
      class="site-nav__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-nav"
      aria-label="Open menu"
      data-nav-toggle
    >
      <span class="sr-only" data-nav-label>Open menu</span>
      <span class="site-nav__toggle-box" aria-hidden="true">
        <span class="site-nav__toggle-line site-nav__toggle-line--1"></span>
        <span class="site-nav__toggle-line site-nav__toggle-line--2"></span>
        <span class="site-nav__toggle-line site-nav__toggle-line--3"></span>
      </span>
    </button>

    <nav
      id="primary-nav"
      class="site-nav"
      aria-label="Primary navigation"
      aria-hidden="true"
      hidden
      data-nav
    >
      <div class="site-nav__panel">
        <div class="site-nav__meta">
          <p class="site-nav__eyebrow">Browse</p>
          <p class="site-nav__title">Fini’s Kitchens</p>
        </div>

        <ul class="site-nav__list">
          {navItems.map((item) => {
            const active = isActive(item.href);
            return (
              <li class="site-nav__item">
                <a
                  href={item.href}
                  class:list={["site-nav__link", "link", active && "is-active"]}
                  aria-current={active ? "page" : undefined}
                >
                  <span>{item.label}</span>
                </a>
              </li>
            );
          })}
        </ul>

        <div class="site-nav__footer">
          <p class="site-nav__note">
            Warm, hard-working kitchens designed for real homes.
          </p>

          <a
            href="/contact"
            class:list={["btn", "btn--primary", "site-nav__cta", contactActive && "is-active"]}
            aria-current={contactActive ? "page" : undefined}
          >
            Contact
          </a>
        </div>
      </div>
    </nav>
  </div>

  <script is:inline>
    (() => {
      const header = document.querySelector("[data-header]");
      if (!(header instanceof HTMLElement)) return;

      const nav = header.querySelector("[data-nav]");
      const btn = header.querySelector("[data-nav-toggle]");
      const navLabel = header.querySelector("[data-nav-label]");
      if (!(nav instanceof HTMLElement) || !(btn instanceof HTMLButtonElement)) return;

      const mq = window.matchMedia("(min-width: 860px)");
      let lastFocused = null;

      let pageBackdrop = document.querySelector(".site-nav-page-backdrop");
      if (!(pageBackdrop instanceof HTMLButtonElement)) {
        pageBackdrop = document.createElement("button");
        pageBackdrop.type = "button";
        pageBackdrop.className = "site-nav-page-backdrop";
        pageBackdrop.setAttribute("aria-hidden", "true");
        pageBackdrop.tabIndex = -1;
        pageBackdrop.hidden = true;
        document.body.appendChild(pageBackdrop);
      }

      const getFocusable = () =>
        [
          ...nav.querySelectorAll(
            'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'
          ),
        ].filter((el) => {
          if (!(el instanceof HTMLElement)) return false;
          if (el.hidden) return false;
          if (el.getAttribute("aria-hidden") === "true") return false;
          return true;
        });

      const setBodyLock = (locked) => {
        document.documentElement.style.overflow = locked ? "hidden" : "";
        document.body.style.overflow = locked ? "hidden" : "";
        document.body.classList.toggle("nav-open", locked);

        pageBackdrop.hidden = !locked;
        pageBackdrop.classList.toggle("is-visible", locked);
      };

      const setNavAccessibility = (open) => {
        nav.setAttribute("aria-hidden", open ? "false" : "true");
        try {
          nav.inert = !open && !mq.matches;
        } catch {}
      };

      const setButtonState = (open) => {
        btn.setAttribute("aria-expanded", open ? "true" : "false");
        btn.setAttribute("aria-label", open ? "Close menu" : "Open menu");
        if (navLabel) navLabel.textContent = open ? "Close menu" : "Open menu";
      };

      const openMobileNav = () => {
        if (mq.matches) return;

        lastFocused = document.activeElement;
        nav.hidden = false;
        header.classList.add("nav-open");
        setButtonState(true);
        setNavAccessibility(true);
        setBodyLock(true);

        requestAnimationFrame(() => {
          const firstFocusable = getFocusable()[0];
          if (firstFocusable instanceof HTMLElement) firstFocusable.focus();
        });
      };

      const closeMobileNav = ({ restoreFocus = true } = {}) => {
        header.classList.remove("nav-open");
        setButtonState(false);
        setNavAccessibility(false);
        setBodyLock(false);

        nav.hidden = true;

        if (restoreFocus && lastFocused instanceof HTMLElement && !mq.matches) {
          lastFocused.focus();
        }
      };

      const syncMode = () => {
        if (mq.matches) {
          nav.hidden = false;
          header.classList.remove("nav-open");
          setButtonState(false);
          setBodyLock(false);
          nav.setAttribute("aria-hidden", "false");
          try {
            nav.inert = false;
          } catch {}
        } else {
          closeMobileNav({ restoreFocus: false });
        }
      };

      const onScroll = () => {
        const y = window.scrollY || 0;
        header.classList.toggle("is-top", y < 8);
        header.classList.toggle("is-scrolled", y >= 8);
        header.classList.toggle("is-compact", y > 12);
      };

      const toggleNav = () => {
        const isOpen = header.classList.contains("nav-open");
        isOpen ? closeMobileNav() : openMobileNav();
      };

      onScroll();
      syncMode();

      window.addEventListener("scroll", onScroll, { passive: true });
      btn.addEventListener("click", toggleNav);

      pageBackdrop.addEventListener("click", () => {
        if (!mq.matches && header.classList.contains("nav-open")) {
          closeMobileNav();
        }
      });

      window.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && header.classList.contains("nav-open")) {
          closeMobileNav();
          return;
        }

        if (e.key !== "Tab" || !header.classList.contains("nav-open") || mq.matches) return;

        const focusable = getFocusable();
        if (!focusable.length) return;

        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        const active = document.activeElement;

        if (e.shiftKey && active === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && active === last) {
          e.preventDefault();
          first.focus();
        }
      });

      nav.addEventListener("click", (e) => {
        const target = e.target;
        if (!(target instanceof Element)) return;

        const link = target.closest("a");
        if (link && !mq.matches) {
          closeMobileNav({ restoreFocus: false });
        }
      });

      if (typeof mq.addEventListener === "function") {
        mq.addEventListener("change", syncMode);
      } else if (typeof mq.addListener === "function") {
        mq.addListener(syncMode);
      }
    })();
  </script>
</header>

<style>
  .skip-link {
    position: absolute;
    left: var(--space-4);
    top: var(--space-4);
    z-index: 1000;
    padding: 0.55rem 0.9rem;
    border-radius: var(--radius-pill);
    background: var(--c-text);
    color: var(--c-on-accent);
    box-shadow: var(--shadow-2);
    transform: translateY(-160%);
    transition: transform var(--dur-2) var(--ease-out);
  }

  .skip-link:focus-visible {
    transform: translateY(0);
    outline: 2px solid var(--c-focus);
    outline-offset: 4px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .site-nav[hidden] {
    display: none !important;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 80;
    isolation: isolate;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    background: rgba(247, 250, 255, 0.78);
    border-bottom: 1px solid rgba(217, 227, 238, 0.55);
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
    transition:
      background var(--dur-2) var(--ease-out),
      border-color var(--dur-2) var(--ease-out),
      box-shadow var(--dur-2) var(--ease-out);
  }

  .site-header::before,
  .site-header::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-2) var(--ease-out);
  }

  .site-header::before {
    top: 0;
    background: linear-gradient(
      to right,
      transparent,
      rgba(255, 255, 255, 0.72),
      transparent
    );
  }

  .site-header::after {
    bottom: -1px;
    background: linear-gradient(
      to right,
      transparent,
      rgba(15, 23, 42, 0.08),
      transparent
    );
  }

  .site-header.is-top {
    background: rgba(247, 250, 255, 0.52);
    border-bottom-color: rgba(217, 227, 238, 0.35);
    box-shadow: none;
  }

  .site-header.is-scrolled {
    background: rgba(247, 250, 255, 0.92);
    border-bottom-color: rgba(217, 227, 238, 0.78);
    box-shadow: 0 12px 30px rgba(15, 23, 42, 0.1);
  }

  .site-header.is-scrolled::before,
  .site-header.is-scrolled::after {
    opacity: 1;
  }

  @supports not ((backdrop-filter: blur(12px)) or (-webkit-backdrop-filter: blur(12px))) {
    .site-header {
      background: rgba(247, 250, 255, 0.95);
    }

    .site-header.is-top {
      background: rgba(247, 250, 255, 0.88);
    }
  }

  /* The homepage starts beneath this header; it becomes solid once the page moves. */
  .site-header--hero.is-top {
    background: linear-gradient(180deg, rgba(7, 18, 30, 0.34), rgba(7, 18, 30, 0));
    border-bottom-color: transparent;
    box-shadow: none;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .site-header--hero.is-top .site-header__brand-mark-wrap {
    background: rgba(21, 45, 65, 0.62);
    border-color: rgba(255, 255, 255, 0.36);
    box-shadow: none;
  }

  .site-header--hero.is-top .site-header__brand-name,
  .site-header--hero.is-top .site-header__brand-tag,
  .site-header--hero.is-top .site-nav__link {
    color: #fff;
    text-shadow: 0 2px 12px rgba(7, 18, 30, 0.35);
  }

  .site-header--hero.is-top .site-header__brand-copy::after {
    background: rgba(255, 255, 255, 0.82);
    box-shadow: none;
  }

  .site-header--hero.is-top .site-nav__link:hover,
  .site-header--hero.is-top .site-nav__link.is-active,
  .site-header--hero.is-top .site-nav__link[aria-current="page"] {
    color: #fff;
    background: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.24);
    box-shadow: none;
  }

  .site-header--hero.is-top .site-nav__link::after {
    background: rgba(255, 255, 255, 0.9);
  }

  .site-header--hero.is-top .site-nav__toggle {
    color: #fff;
    background: rgba(7, 18, 30, 0.42);
    border-color: rgba(255, 255, 255, 0.42);
    box-shadow: none;
  }

  .site-header--hero.is-top .site-nav__toggle:hover {
    background: rgba(7, 18, 30, 0.6);
    border-color: rgba(255, 255, 255, 0.7);
  }

  .site-header--hero.is-top .site-nav__link:focus-visible,
  .site-header--hero.is-top .site-nav__toggle:focus-visible {
    outline-color: #fff;
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-4);
    padding-block: 0.85rem;
    transition: padding var(--dur-2) var(--ease-out);
  }

  .site-header.is-compact .site-header__inner {
    padding-block: 0.6rem;
  }

  .site-header__brand {
    display: inline-grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 0.9rem;
    min-width: 0;
    text-decoration: none;
    transition:
      opacity var(--dur-2) var(--ease-out),
      transform var(--dur-2) var(--ease-out);
  }

  .site-header__brand-mark-wrap {
    display: grid;
    place-items: center;
    width: clamp(46px, 5.2vw, 54px);
    aspect-ratio: 1;
    border-radius: 1rem;
    background: linear-gradient(
      180deg,
      rgba(157, 184, 233, 0.24),
      rgba(157, 184, 233, 0.1)
    );
    border: 1px solid rgba(157, 184, 233, 0.34);
    box-shadow:
      0 8px 18px rgba(15, 23, 42, 0.07),
      inset 0 1px 0 rgba(255, 255, 255, 0.55);
    overflow: hidden;
    transition: transform var(--dur-2) var(--ease-out);
    flex-shrink: 0;
  }

  .site-header__brand-mark {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .site-header__brand-copy {
    position: relative;
    display: grid;
    align-content: center;
    gap: 0.04rem;
    min-width: 0;
    line-height: 1;
  }

  .site-header__brand-copy::after {
    content: "";
    width: 3rem;
    height: 0.24rem;
    margin-top: 0.12rem;
    border-radius: 999px;
    background: linear-gradient(
      90deg,
      rgba(157, 184, 233, 0.18),
      rgba(78, 109, 149, 0.95),
      rgba(157, 184, 233, 0.18)
    );
    box-shadow: 0 4px 10px rgba(78, 109, 149, 0.16);
  }

  .site-header__brand-name {
    font-family: "Baloo 2", var(--font-sans, Inter, system-ui, sans-serif);
    font-size: clamp(1.34rem, 1.04rem + 0.9vw, 1.82rem);
    font-weight: 800;
    line-height: 0.86;
    letter-spacing: -0.03em;
    color: #1f2a37;
    text-shadow:
      0 1px 0 rgba(255, 255, 255, 0.5),
      0 8px 18px rgba(15, 23, 42, 0.06);
    white-space: nowrap;
  }

  .site-header__brand-tag {
    font-family: "Caveat", cursive;
    font-size: clamp(0.92rem, 0.84rem + 0.3vw, 1.08rem);
    line-height: 0.92;
    color: var(--c-accent);
    transform: translateY(-0.04rem);
    padding-left: 0.16rem;
    white-space: nowrap;
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.45);
  }

  .site-header.is-compact .site-header__brand-mark-wrap {
    transform: scale(0.96);
  }

  .site-nav__toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: 999px;
    border: 1px solid rgba(157, 184, 233, 0.28);
    background: rgba(255, 255, 255, 0.82);
    color: var(--c-text);
    box-shadow:
      0 10px 20px rgba(15, 23, 42, 0.08),
      inset 0 1px 0 rgba(255, 255, 255, 0.7);
    cursor: pointer;
    transition:
      transform var(--dur-2) var(--ease-out),
      background var(--dur-2) var(--ease-out),
      border-color var(--dur-2) var(--ease-out),
      box-shadow var(--dur-2) var(--ease-out);
  }

  .site-nav__toggle:hover {
    transform: translateY(-1px);
    border-color: rgba(157, 184, 233, 0.45);
    background: rgba(255, 255, 255, 0.94);
  }

  .site-nav__toggle:focus-visible {
    outline: 2px solid var(--c-focus);
    outline-offset: 3px;
  }

  .site-nav__toggle-box {
    position: relative;
    width: 20px;
    height: 14px;
  }

  .site-nav__toggle-line {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    border-radius: 999px;
    background: currentColor;
    transform-origin: center;
    transition:
      transform var(--dur-2) var(--ease-out),
      opacity var(--dur-2) var(--ease-out),
      top var(--dur-2) var(--ease-out);
  }

  .site-nav__toggle-line--1 { top: 0; }
  .site-nav__toggle-line--2 { top: 6px; }
  .site-nav__toggle-line--3 { top: 12px; }

  .site-header.nav-open .site-nav__toggle {
    background: rgba(157, 184, 233, 0.18);
    border-color: rgba(157, 184, 233, 0.5);
    box-shadow:
      0 12px 22px rgba(15, 23, 42, 0.12),
      inset 0 1px 0 rgba(255, 255, 255, 0.6);
  }

  .site-header.nav-open .site-nav__toggle-line--1 {
    top: 6px;
    transform: rotate(45deg);
  }

  .site-header.nav-open .site-nav__toggle-line--2 {
    opacity: 0;
    transform: scaleX(0.3);
  }

  .site-header.nav-open .site-nav__toggle-line--3 {
    top: 6px;
    transform: rotate(-45deg);
  }

  .site-nav {
    justify-self: end;
    display: flex;
    align-items: center;
    font-size: 0.95rem;
  }

  .site-nav__panel {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  .site-nav__meta,
  .site-nav__note {
    display: none;
  }

  .site-nav__list {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0;
    margin: 0;
  }

  .site-nav__item {
    display: flex;
  }

  .site-nav__link {
    color: var(--c-text);
    padding: 0.72rem 0.9rem 0.9rem;
    border-radius: 999px;
    text-decoration: none;
    position: relative;
    white-space: nowrap;
    background: transparent;
    border: 1px solid transparent;
    transition:
      color var(--dur-2) var(--ease-out),
      background var(--dur-2) var(--ease-out),
      border-color var(--dur-2) var(--ease-out),
      transform var(--dur-2) var(--ease-out);
  }

  .site-nav__link:hover {
    color: var(--c-accent);
    background: rgba(157, 184, 233, 0.1);
    border-color: rgba(157, 184, 233, 0.14);
  }

  .site-nav__link:focus-visible {
    outline: 2px solid var(--c-focus);
    outline-offset: 2px;
  }

  .site-nav__link::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 0.46rem;
    width: min(2.4rem, calc(100% - 1.4rem));
    height: 3px;
    border-radius: 999px;
    background: linear-gradient(
      90deg,
      rgba(157, 184, 233, 0.2),
      rgba(78, 109, 149, 0.96),
      rgba(157, 184, 233, 0.2)
    );
    transform: translateX(-50%) scaleX(0.42);
    opacity: 0;
    transition:
      opacity var(--dur-2) var(--ease-out),
      transform var(--dur-2) var(--ease-out);
  }

  .site-nav__link.is-active,
  .site-nav__link[aria-current="page"] {
    color: var(--c-text);
    background: rgba(157, 184, 233, 0.12);
    border-color: rgba(157, 184, 233, 0.18);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.56);
  }

  .site-nav__link.is-active::after,
  .site-nav__link[aria-current="page"]::after {
    opacity: 1;
    transform: translateX(-50%) scaleX(1);
  }

  .site-nav__cta {
    margin-left: 0.25rem;
    white-space: nowrap;
    box-shadow: 0 10px 22px rgba(78, 109, 149, 0.18);
  }

  .site-nav__cta.is-active,
  .site-nav__cta[aria-current="page"] {
    filter: saturate(1.05);
    box-shadow:
      0 12px 24px rgba(78, 109, 149, 0.22),
      inset 0 1px 0 rgba(255, 255, 255, 0.28);
  }

  :global(body.nav-open) {
    touch-action: none;
    overscroll-behavior: contain;
  }

  :global(.site-nav-page-backdrop) {
    position: fixed;
    inset: 0;
    z-index: 70;
    margin: 0;
    padding: 0;
    border: 0;
    opacity: 0;
    pointer-events: none;
    background:
      linear-gradient(
        180deg,
        rgba(244, 247, 252, 0.68),
        rgba(233, 239, 247, 0.88)
      );
    backdrop-filter: blur(18px) saturate(0.72) brightness(0.9);
    -webkit-backdrop-filter: blur(18px) saturate(0.72) brightness(0.9);
    transition: opacity var(--dur-2) var(--ease-out);
    appearance: none;
  }

  :global(.site-nav-page-backdrop.is-visible) {
    opacity: 1;
    pointer-events: auto;
  }

  @supports not ((backdrop-filter: blur(12px)) or (-webkit-backdrop-filter: blur(12px))) {
    :global(.site-nav-page-backdrop) {
      background: rgba(235, 241, 248, 0.9);
    }
  }

  @media (pointer: coarse) {
    .site-nav__link {
      padding: 0.82rem 0.94rem 0.98rem;
    }
  }

  @media (max-width: 1120px) {
    .site-nav__panel {
      gap: var(--space-4);
    }

    .site-nav {
      font-size: 0.92rem;
    }

    .site-nav__link {
      padding-inline: 0.78rem;
    }
  }

  @media (max-width: 1024px) {
    .site-header__brand-tag {
      display: none;
    }
  }

  @media (max-width: 859px) {
    .site-header__inner {
      grid-template-columns: 1fr auto;
      gap: 0.75rem;
      padding-block: 0.72rem;
    }

    .site-header__brand {
      gap: 0.62rem;
      max-width: none;
    }

    .site-header__brand-mark-wrap {
      width: 42px;
