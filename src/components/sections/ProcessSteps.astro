---
interface Step {
  title: string;
  body: string;
}

interface Props {
  steps: Step[];
}

const { steps = [] } = Astro.props;
---

<section class="process-teaser" aria-labelledby="process-teaser-title">
  <div class="container process-teaser__frame">
    <header class="process-teaser__intro">
      <div>
        <p class="process-teaser__eyebrow">How it works</p>
        <h2 id="process-teaser-title">A clear path from first conversation to finished kitchen.</h2>
      </div>

      <p class="process-teaser__summary">
        Five straightforward stages, with clear decisions and guidance at each step.
      </p>
    </header>

    <ol class="process-rail" data-motion-process>
      <li class="process-rail__track" aria-hidden="true" role="presentation">
        <span data-process-line></span>
      </li>
      {steps.map((step, index) => (
        <li class="process-rail__step" data-process-stage>
          <span class="process-rail__node" aria-hidden="true" data-process-node></span>
          <p class="process-rail__number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</p>
          <div class="process-rail__copy">
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </div>
        </li>
      ))}
    </ol>

    <a class="process-teaser__link" href="/process">
      <span>See the full process</span>
      <span aria-hidden="true">→</span>
    </a>
  </div>
</section>

<style>
  .process-teaser {
    padding-block: var(--home-section-y-tight);
    background: var(--c-paper);
  }

  .process-teaser__frame {
    display: grid;
    gap: var(--home-layout-gap-tight);
  }

  .process-teaser__intro {
    display: grid;
    gap: var(--space-6);
    align-items: end;
  }

  .process-teaser__eyebrow {
    margin-bottom: var(--space-4);
    color: var(--c-blue);
    font-size: var(--eyebrow-size);
    font-weight: var(--eyebrow-weight);
    letter-spacing: var(--eyebrow-tracking);
    text-transform: uppercase;
    line-height: var(--eyebrow-line-height);
  }

  .process-teaser__intro h2 {
    max-width: 14ch;
    color: var(--c-ink);
    font-size: clamp(2.35rem, 4.4vw, 4.35rem);
    font-weight: 580;
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .process-teaser__summary {
    max-width: 33ch;
    color: var(--c-navy);
    font-size: var(--fs-2);
    line-height: var(--lh-snug);
  }

  .process-rail {
    position: relative;
    display: grid;
    gap: 0;
    padding: 0 0 0 var(--space-8);
    margin: 0;
    list-style: none;
  }

  .process-rail__track {
    position: absolute;
    top: 1.06rem;
    bottom: 0;
    left: 0;
    width: 1px;
    background: var(--c-rule-blue);
    pointer-events: none;
  }

  .process-rail__track span {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--c-blue);
    transform-origin: top left;
  }

  .process-rail__step {
    position: relative;
    display: grid;
    gap: var(--space-3);
    padding: 0 0 var(--space-8);
  }

  .process-rail__step:last-child {
    padding-bottom: 0;
  }

  .process-rail__node {
    position: absolute;
    top: 0.75rem;
    left: calc(-1 * var(--space-8) - 0.31rem);
    width: 0.62rem;
    height: 0.62rem;
    border-radius: 50%;
    background: var(--c-blue-muted);
    box-shadow: 0 0 0 4px var(--c-paper);
  }

  .process-rail.motion-ready .process-rail__node {
    background: var(--c-blue-pale);
    transition: background var(--dur-2) var(--ease-out), transform var(--dur-2) var(--ease-out);
  }

  .process-rail.motion-ready .process-rail__number {
    color: var(--c-blue-muted);
    transition: color var(--dur-2) var(--ease-out);
  }

  .process-rail .is-complete .process-rail__node,
  .process-rail .is-current .process-rail__node {
    background: var(--c-blue);
  }

  .process-rail .is-current .process-rail__node {
    transform: scale(1.3);
  }

  .process-rail.motion-ready .is-current .process-rail__number,
  .process-rail.motion-ready .is-complete .process-rail__number {
    color: var(--c-blue);
  }

  .process-rail .is-seen .process-rail__number,
  .process-rail .is-seen h3,
  .process-rail .is-seen .process-rail__copy p {
    animation: motion-resolve var(--dur-narrative) var(--ease-out) both;
  }

  .process-rail .is-seen h3 { animation-delay: 60ms; }
  .process-rail .is-seen .process-rail__copy p { animation-delay: 120ms; }

  .process-rail__number {
    color: var(--c-blue);
    font-size: clamp(2.45rem, 5vw, 4rem);
    font-weight: 590;
    line-height: 0.84;
    letter-spacing: -0.06em;
  }

  .process-rail__copy h3 {
    max-width: 22ch;
    color: var(--c-ink);
    font-size: clamp(1.2rem, 1.6vw, 1.45rem);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.025em;
  }

  .process-rail__copy p {
    max-width: 48ch;
    margin-top: var(--space-2);
    color: var(--c-text-muted);
    font-size: var(--fs-0);
    line-height: var(--lh-snug);
  }

  .process-teaser__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    width: fit-content;
    color: var(--c-navy);
    font-size: var(--fs-0);
    font-weight: 650;
    text-decoration: none;
  }

  .process-teaser__link span:first-child {
    padding-bottom: 0.16rem;
    border-bottom: 1px solid currentColor;
  }

  .process-teaser__link span:last-child {
    transition: transform var(--dur-2) var(--ease-out);
  }

  .process-teaser__link:hover span:last-child,
  .process-teaser__link:focus-visible span:last-child {
    transform: translateX(0.2rem);
  }

  .process-teaser__link:focus-visible {
    outline-color: var(--c-blue);
    outline-offset: 5px;
  }

  @media (min-width: 48rem) {
    .process-teaser__intro {
      grid-template-columns: minmax(0, 1.15fr) minmax(16rem, 0.85fr);
    }
  }

  @media (min-width: 72rem) {
    .process-rail {
      --process-gap: clamp(var(--space-5), 2.4vw, var(--space-7));
      --process-node-y: clamp(3rem, 4vw, 3.6rem);
      position: relative;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: var(--process-gap);
      padding: 0;
      border-left: 0;
    }

    .process-rail__track {
      top: var(--process-node-y);
      bottom: auto;
      left: 0.34rem;
      width: calc(80% + var(--process-gap) * 0.8);
      height: 1px;
      background: var(--c-rule-blue);
    }

    .process-rail__step {
      gap: 0;
      padding: 0;
    }

    .process-rail__node {
      z-index: 2;
      top: calc(var(--process-node-y) - 0.34rem);
      left: 0;
      width: 0.68rem;
      height: 0.68rem;
      box-shadow: 0 0 0 4px var(--c-paper);
    }

    .process-rail__number {
      position: relative;
      z-index: 1;
      width: fit-content;
      padding-right: var(--space-3);
      background: var(--c-paper);
    }

    .process-rail__copy {
      padding-top: clamp(2.8rem, 4vw, 3.75rem);
    }

    .process-rail__copy p {
      max-width: 20ch;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .process-teaser__link span:last-child {
      transition: none;
    }

    .process-teaser__link:hover span:last-child {
      transform: none;
    }
  }
</style>
