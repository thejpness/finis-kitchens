---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Step {
  title: string;
  body: string;
  label: string;
  image: ImageMetadata;
  alt: string;
  imagePosition?: string;
  imageCrop?: string;
}
interface Props { steps: Step[]; }
const { steps = [] } = Astro.props;
---

<section class="process-story" aria-labelledby="process-story-title" data-motion-story>
  <header class="process-story__intro">
    <div class="container process-story__intro-grid">
      <div>
        <p class="process-story__eyebrow">The making of your kitchen</p>
        <h2 id="process-story-title">From the first idea<br />to <em>everyday life.</em></h2>
      </div>
      <p class="process-story__summary">
        A clear path from first conversation to finished kitchen.
        Five stages, with practical guidance along the way.
      </p>
    </div>
  </header>

  <div class="container process-story__journey">
    <!-- Decorative desktop canvas; the complete editorial layout is the default. -->
    <div class="process-story__canvas-track" aria-hidden="true">
      <div class="process-story__canvas">
        <div class="process-story__layers"></div>
        <p class="process-story__canvas-note">Made to be lived in.</p>
      </div>
    </div>
    <div class="process-story__thread" aria-hidden="true"><span data-process-line></span></div>
    <ol class="process-story__chapters" role="list">
      {steps.map((step, index) => (
        <li class="process-story__chapter" data-process-stage>
          <div class="process-story__photo" data-story-photo style={{ "--image-position": step.imagePosition ?? "center" }}>
            <Picture
              src={step.image}
              alt={step.alt}
              formats={["avif", "webp"]}
              width={1280}
              height={1085}
              fit="cover"
              position={step.imageCrop ?? "center"}
              widths={[400, 640, 960, 1280]}
              sizes="(min-width: 80rem) 650px, (min-width: 68rem) 52vw, (min-width: 48rem) 50vw, calc(100vw - 2rem)"
              loading="lazy"
              decoding="async"
            />
            <span class="process-story__edge-haze" aria-hidden="true"></span>
            <span class="process-story__veil" aria-hidden="true"></span>
          </div>
          <div class="process-story__copy">
            <span class="process-story__node" aria-hidden="true" data-process-node></span>
            <p class="process-story__number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</p>
            <p class="process-story__label">{step.label}</p>
            <h3>{step.title}</h3>
            <p class="process-story__body">{step.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>

  <div class="container process-story__outro">
    <p>Made for the life you live.</p>
    <a class="process-story__link" href="/process">
      <span>See the full process</span><span aria-hidden="true">↗</span>
    </a>
  </div>
</section>

<style>
  .process-story {
    --photo-share: 56%;
    --chapter-space: clamp(3rem, 6vw, 5rem);
    --chapter-gap: clamp(2rem, 5vw, 4rem);
    background: var(--c-paper);
    color: var(--c-navy);
    scroll-margin-top: 5rem;
  }
  .process-story__intro {
    padding-block: clamp(3.5rem, 6vw, 5.5rem) clamp(5.5rem, 8vw, 8rem);
    color: var(--c-paper);
    background: var(--c-navy);
  }
  .process-story__intro-grid { display: grid; gap: 1.75rem; }
  .process-story__eyebrow,
  .process-story__label {
    font-size: var(--eyebrow-size);
    font-weight: var(--eyebrow-weight);
    letter-spacing: var(--eyebrow-tracking);
    line-height: 1.3;
    text-transform: uppercase;
  }
  .process-story__eyebrow { margin-bottom: 1.5rem; color: var(--c-blue-pale); }
  .process-story__intro h2 {
    max-width: 20ch;
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 5.25vw, 4.8rem);
    font-weight: 450;
    line-height: 1.04;
    letter-spacing: -0.035em;
    text-wrap: initial;
  }
  .process-story__intro h2 em { color: var(--c-blue-pale); font-weight: inherit; }
  .process-story__summary {
    max-width: 29ch;
    color: var(--c-brand-100);
    font-size: clamp(1rem, 1.25vw, 1.125rem);
    line-height: 1.65;
  }
  .process-story__journey { position: relative; margin-top: -3rem; }
  .process-story__canvas-track { display: none; }
  .process-story__thread { position: absolute; top: 0; bottom: 0; left: var(--container-pad); width: 1px; background: var(--c-rule-blue); }
  .process-story__thread span { display: block; width: 100%; height: 100%; background: var(--c-blue); transform-origin: top; }
  .process-story__chapters { list-style: none; padding: 0; margin: 0; padding-left: 1.5rem; }
  .process-story__chapter { min-width: 0; margin-bottom: var(--chapter-space); }
  .process-story__photo {
    position: relative;
    isolation: isolate;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--c-canvas-warm);
  }
  .process-story__photo :global(picture),
  .process-story__photo :global(img) { display: block; width: 100%; height: 100%; }
  .process-story__photo :global(img) { object-fit: cover; object-position: var(--image-position); }
  .process-story__edge-haze,
  .process-story__veil { position: absolute; inset: 0; pointer-events: none; }
  .process-story__edge-haze {
    background:
      linear-gradient(90deg, var(--c-paper), transparent 18%, transparent 86%, var(--c-brand-100)),
      linear-gradient(0deg, var(--c-paper), transparent 24%, transparent 90%, var(--c-paper));
    opacity: 0.16;
  }
  .process-story__veil {
    background:
      radial-gradient(ellipse at 25% 30%, var(--c-paper), transparent 72%),
      linear-gradient(130deg, var(--c-canvas-warm), var(--c-brand-100));
    opacity: 0;
  }
  .process-story__copy { position: relative; padding: 1.75rem 0 0; }
  .process-story__label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
    color: var(--c-blue);
  }

  .process-story__copy h3 {
    max-width: 18ch;
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.1vw, 3rem);
    font-weight: 450;
    letter-spacing: -0.03em;
    line-height: 1.08;
    text-wrap: initial;
  }
  .process-story__body {
    max-width: 32ch;
    margin-top: 1.25rem;
    color: var(--c-navy);
    font-size: clamp(0.95rem, 1.1vw, 1.05rem);
    line-height: 1.7;
  }
  .process-story__chapter:nth-child(2) .process-story__photo { margin-left: 1.25rem; aspect-ratio: 1.12; }
  .process-story__chapter:nth-child(3) .process-story__photo { margin-right: 1.25rem; }
  .process-story__chapter:last-child .process-story__photo { aspect-ratio: 1.15; }
  .process-story__outro {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 0.5rem var(--home-section-y-tight);
  }
  .process-story__outro > p {
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 2.5vw, 2.25rem);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.025em;
  }
  .process-story__link { display: inline-flex; gap: 1.5rem; align-items: center; font-size: var(--fs-0); font-weight: 600; }
  .process-story__link span:first-child { border-bottom: 1px solid var(--c-blue-muted); padding-bottom: 0.2rem; }
  .process-story__link span:last-child { font-size: 1.5rem; }
  .process-story__link:hover,
  .process-story__link:focus-visible { color: var(--c-blue); }
  .process-story__link:focus-visible { outline-offset: 6px; }

  @media (max-width: 47.99rem) {
    .process-story__intro h2 { font-size: clamp(2.35rem, 11.7vw, 3.25rem); }
  }

  @media (min-width: 48rem) {
    .process-story__intro-grid { grid-template-columns: 1.6fr 1fr; align-items: end; gap: 3rem; }
    .process-story__summary { padding-bottom: 0.5rem; }
    .process-story__chapter {
      display: grid;
      grid-template-columns: 1.12fr 0.88fr;
      gap: var(--chapter-gap);
      align-items: center;
    }
    .process-story__photo { aspect-ratio: 1.12; }
    .process-story__copy { padding: 1rem 0; }
    .process-story__chapter:nth-child(2) .process-story__photo,
    .process-story__chapter:nth-child(3) .process-story__photo { margin: 0; }
    .process-story__thread { left: calc(var(--container-pad) + (100% - 2 * var(--container-pad) - 1.5rem - var(--chapter-gap)) * 0.56 + var(--chapter-gap)); }
  }

  @media (min-width: 68rem) and (min-height: 38rem) {
    .process-story {
      --photo-height: min(calc(min(var(--container-max), 100vw - 2 * var(--container-pad)) * 0.56 / 1.18), calc(100svh - 11rem));
    }
    .process-story__intro-grid { grid-template-columns: var(--photo-share) 1fr; gap: 0; }
    .process-story__chapters { padding-left: 0; }
    .process-story__summary { margin-left: clamp(3rem, 6vw, 5.5rem); }
    .process-story__journey { margin-top: -3.5rem; }
    .process-story__chapter,
    .process-story__chapter:nth-child(even) {
      grid-template-columns: var(--photo-share) 1fr;
      gap: 0;
      min-height: max(76svh, calc(var(--photo-height) + 4rem));
      margin: 0;
    }
    .process-story__photo,
    .process-story__chapter:nth-child(even) .process-story__photo,
    .process-story__chapter:nth-child(2) .process-story__photo,
    .process-story__chapter:last-child .process-story__photo { aspect-ratio: auto; height: var(--photo-height); grid-column: 1; grid-row: 1; }
    .process-story__copy,
    .process-story__chapter:nth-child(even) .process-story__copy {
      grid-column: 2;
      grid-row: 1;
      padding: 2rem 0 2rem clamp(3rem, 6vw, 5.5rem);
    }
    .process-story__chapter:first-child { align-items: start; min-height: max(82svh, calc(var(--photo-height) + 4rem)); }
    .process-story__chapter:nth-child(2),
    .process-story__chapter:nth-child(4) { min-height: max(60svh, calc(var(--photo-height) + 4rem)); }
    .process-story__chapter:last-child { min-height: max(96svh, calc(var(--photo-height) + 4rem)); }
    .process-story__chapter:first-child .process-story__copy { align-self: center; }
    .process-story__outro { padding-top: 2.5rem; }
    /* Keep small labels readable beside the photographic canvas. */
    .process-story.is-enhanced .process-story__label { color: var(--c-navy); }
    .process-story.is-enhanced .process-story__canvas-track {
      display: block;
      position: absolute;
      top: 0;
      bottom: 0;
      left: var(--container-pad);
      width: calc((100% - 2 * var(--container-pad)) * 0.56);
    }
    .process-story__canvas { position: sticky; top: max(5rem, calc((100svh - var(--photo-height)) / 2 - 1rem)); }
    .process-story__layers { position: relative; height: var(--photo-height); overflow: hidden; background: var(--c-canvas-warm); }
    .process-story.is-enhanced .process-story__photo {
      position: absolute;
      inset: 0;
      margin: 0;
      width: 100%;
      height: 100%;
      aspect-ratio: auto;
    }
    .process-story__canvas-note {
      margin-top: 1rem;
      color: var(--c-blue);
      font-family: var(--font-display);
      font-size: 1.1rem;
      font-style: italic;
    }

  }
  .process-story__node { position: absolute; left: -1.85rem; top: 2.05rem; width: 0.7rem; height: 0.7rem; border-radius: 50%; background: var(--c-blue-muted); box-shadow: 0 0 0 5px var(--c-paper); transition: background var(--dur-2) var(--ease-out), transform var(--dur-2) var(--ease-out); }
  .process-story__number { margin-bottom: 0.75rem; color: var(--c-blue); font-size: 1.5rem; font-weight: 500; line-height: 1; letter-spacing: -0.04em; }
  .motion-ready .process-story__node { background: var(--c-brand-200); }
  .process-story__chapter.is-complete .process-story__node,
  .process-story__chapter.is-current .process-story__node { background: var(--c-blue); }
  .process-story__chapter.is-current .process-story__node { transform: scale(1.25); }
  .process-story__chapter.is-current .process-story__number { color: var(--c-ink); }
  .process-story__chapter.is-seen .process-story__number,
  .process-story__chapter.is-seen h3,
  .process-story__chapter.is-seen .process-story__body { animation: motion-resolve var(--dur-narrative) var(--ease-out) both; }
  .process-story__chapter.is-seen h3 { animation-delay: 60ms; }
  .process-story__chapter.is-seen .process-story__body { animation-delay: 120ms; }
  @media (min-width: 48rem) {
    .process-story__node { top: 1.15rem; }
  }
  @media (min-width: 68rem) and (min-height: 38rem) {
    .process-story__node { left: calc(clamp(3rem, 6vw, 5.5rem) - 1.6rem); top: 2.15rem; }
    .process-story__thread { left: calc(var(--container-pad) + (100% - 2 * var(--container-pad)) * 0.56 + clamp(3rem, 6vw, 5.5rem) - 1.25rem); }
  }
  @media (prefers-reduced-motion: reduce) {
    .process-story__node { transition: none; }
    .process-story__chapter.is-seen .process-story__number,
    .process-story__chapter.is-seen h3,
    .process-story__chapter.is-seen .process-story__body { animation: none; }
  }
</style>
