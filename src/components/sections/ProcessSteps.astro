---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Step {
  title: string;
  body: string;
  label: string;
  image: ImageMetadata;
  alt: string;
  imagePosition?: string;
}

interface Props {
  steps: Step[];
}

const { steps = [] } = Astro.props;
---

<section class="process-teaser" aria-labelledby="process-teaser-title">
  <div class="container process-teaser__frame">
    <header class="process-teaser__intro">
      <div>
        <p class="process-teaser__eyebrow">How it works</p>
        <h2 id="process-teaser-title">A clear path from first conversation to finished kitchen.</h2>
      </div>
      <p class="process-teaser__summary">
        Five straightforward stages, with clear decisions and guidance at each step.
      </p>
    </header>

    <ol class="process-journey-preview">
      {steps.map((step) => (
        <li class="process-journey-preview__stage">
          <div class="process-journey-preview__media" style={{ "--image-position": step.imagePosition ?? "center" }}>
            <Picture
              src={step.image}
              alt={step.alt}
              formats={["avif", "webp"]}
              widths={[360, 560, 760, 1000]}
              sizes="(min-width: 48rem) min(44vw, 35rem), calc(100vw - 4.5rem)"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="process-journey-preview__copy">
            <p class="process-journey-preview__label">{step.label}</p>
            <h3>{step.title}</h3>
            <p class="process-journey-preview__body">{step.body}</p>
          </div>
          <span class="process-journey-preview__connector" aria-hidden="true"></span>
        </li>
      ))}
    </ol>

    <a class="process-teaser__link" href="/process">
      <span>See the full process</span>
      <span aria-hidden="true">→</span>
    </a>
  </div>
</section>

<script>
  const section = document.querySelector<HTMLElement>(".process-teaser");
  if (section && "IntersectionObserver" in window && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        entry.target.classList.add("is-visible");
        observer.unobserve(entry.target);
      }
    }, { threshold: 0.3, rootMargin: "0px 0px -30% 0px" });

    section.querySelectorAll(".process-journey-preview__stage").forEach((stage) => observer.observe(stage));
  }
</script>

<style>
  .process-teaser {
    padding-block: var(--home-section-y-tight);
    background: var(--c-paper);
  }

  .process-teaser__frame {
    display: grid;
    gap: var(--home-layout-gap-tight);
  }

  .process-teaser__intro {
    display: grid;
    gap: var(--space-6);
    align-items: end;
  }

  .process-teaser__eyebrow {
    margin-bottom: var(--space-4);
    color: var(--c-blue);
    font-size: var(--eyebrow-size);
    font-weight: var(--eyebrow-weight);
    letter-spacing: var(--eyebrow-tracking);
    text-transform: uppercase;
    line-height: var(--eyebrow-line-height);
  }

  .process-teaser__intro h2 {
    max-width: 14ch;
    color: var(--c-ink);
    font-size: clamp(2.35rem, 4.4vw, 4.35rem);
    font-weight: 580;
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .process-teaser__summary {
    max-width: 33ch;
    color: var(--c-navy);
    font-size: var(--fs-2);
    line-height: var(--lh-snug);
  }

  .process-journey-preview {
    --stage-gap: clamp(2rem, 4vw, 3.5rem);
    position: relative;
    display: grid;
    gap: var(--stage-gap);
    padding: 0 0 0 1.75rem;
    margin: 0;
    list-style: none;
  }

  .process-journey-preview::before {
    content: "";
    position: absolute;
    top: 0.75rem;
    bottom: 0.75rem;
    left: 0.37rem;
    width: 1px;
    background: var(--c-rule-blue);
  }

  .process-journey-preview__stage {
    position: relative;
    display: grid;
    gap: var(--space-5);
    min-width: 0;
  }

  .process-journey-preview__stage::before {
    content: "";
    position: absolute;
    top: 0.65rem;
    left: -1.74rem;
    width: 0.7rem;
    height: 0.7rem;
    border: 1px solid var(--c-blue-muted);
    border-radius: 50%;
    background: var(--c-paper);
    box-shadow: 0 0 0 4px var(--c-paper);
  }

  .process-journey-preview__connector {
    position: absolute;
    z-index: 1;
    top: 100%;
    left: -1.76rem;
    width: 0.75rem;
    height: var(--stage-gap);
    transform-origin: top;
    transform: scaleY(0);
  }

  .process-journey-preview__stage:last-child .process-journey-preview__connector {
    display: none;
  }

  .process-journey-preview__connector::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0.33rem;
    left: 50%;
    width: 1px;
    background: var(--c-blue-muted);
  }

  .process-journey-preview__connector::after {
    content: "";
    position: absolute;
    bottom: 0.2rem;
    left: calc(50% - 0.13rem);
    width: 0.27rem;
    height: 0.27rem;
    border-right: 1px solid var(--c-blue-muted);
    border-bottom: 1px solid var(--c-blue-muted);
    transform: rotate(45deg);
  }

  .process-journey-preview__media {
    position: relative;
    isolation: isolate;
    height: clamp(12.5rem, 50vw, 16rem);
    min-width: 0;
    overflow: hidden;
    background: var(--c-canvas-warm);
  }

  .process-journey-preview__media::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: rgba(255, 253, 252, 0.88);
    transform: translateX(-101%);
  }

  .process-journey-preview__stage:nth-child(even) .process-journey-preview__media::after {
    transform: translateX(101%);
  }

  .process-journey-preview__media :global(picture),
  .process-journey-preview__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .process-journey-preview__media :global(img) {
    object-fit: cover;
    object-position: var(--image-position);
  }

  .process-journey-preview__copy {
    align-self: center;
    min-width: 0;
    padding-block: var(--space-2);
  }

  .process-journey-preview__label {
    margin-bottom: var(--space-3);
    color: var(--c-blue);
    font-size: var(--eyebrow-size);
    font-weight: var(--eyebrow-weight);
    letter-spacing: var(--eyebrow-tracking);
    line-height: var(--eyebrow-line-height);
    text-transform: uppercase;
  }

  .process-journey-preview__copy h3 {
    max-width: 18ch;
    color: var(--c-ink);
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3vw, 2.75rem);
    font-weight: 450;
    line-height: 1.04;
    letter-spacing: -0.025em;
  }

  .process-journey-preview__body {
    max-width: 38ch;
    margin-top: var(--space-4);
    color: var(--c-text-muted);
    font-size: clamp(0.94rem, 1.2vw, 1.06rem);
    line-height: 1.55;
  }

  .process-teaser__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    width: fit-content;
    color: var(--c-navy);
    font-size: var(--fs-0);
    font-weight: 650;
    text-decoration: none;
  }

  .process-teaser__link span:first-child {
    padding-bottom: 0.16rem;
    border-bottom: 1px solid currentColor;
  }

  .process-teaser__link span:last-child {
    transition: transform var(--dur-2) var(--ease-out);
  }

  .process-teaser__link:hover span:last-child {
    transform: translateX(0.2rem);
  }

  .process-teaser__link:focus-visible {
    outline-color: var(--c-blue);
    outline-offset: 5px;
  }

  @media (min-width: 48rem) {
    .process-teaser__intro {
      grid-template-columns: minmax(0, 1.15fr) minmax(16rem, 0.85fr);
    }

    .process-journey-preview {
      --stage-gap: clamp(1.5rem, 3vw, 2.5rem);
      padding: 0;
    }

    .process-journey-preview::before {
      top: 0;
      bottom: 0;
      left: 50%;
    }

    .process-journey-preview__stage {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: clamp(3rem, 7vw, 7rem);
      align-items: center;
    }

    .process-journey-preview__stage::before {
      z-index: 1;
      top: calc(50% - 0.35rem);
      left: calc(50% - 0.35rem);
    }

    .process-journey-preview__connector {
      left: calc(50% - 0.375rem);
    }

    .process-journey-preview__stage:nth-child(even) .process-journey-preview__media {
      grid-column: 2;
    }

    .process-journey-preview__stage:nth-child(even) .process-journey-preview__copy {
      grid-column: 1;
      grid-row: 1;
      justify-self: end;
      width: min(100%, 29rem);
    }

    .process-journey-preview__media {
      height: clamp(13rem, 25vw, 18rem);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .process-journey-preview__stage.is-visible .process-journey-preview__media :global(img) {
      animation: process-image-settle 1000ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .process-journey-preview__stage.is-visible .process-journey-preview__media::after {
      animation: process-wipe-left 1000ms cubic-bezier(0.55, 0, 0.2, 1) both;
    }

    .process-journey-preview__stage.is-visible:nth-child(even) .process-journey-preview__media::after {
      animation-name: process-wipe-right;
    }

    .process-journey-preview__stage.is-visible .process-journey-preview__copy h3 {
      animation: process-copy-rise 690ms 100ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .process-journey-preview__stage.is-visible .process-journey-preview__body {
      animation: process-copy-rise 690ms 220ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .process-journey-preview__stage.is-visible::before {
      animation: process-marker 650ms var(--ease-out) both;
    }

    .process-journey-preview__stage.is-visible .process-journey-preview__connector {
      animation: process-connector 740ms 240ms var(--ease-out) both;
    }

    @keyframes process-image-settle {
      from { opacity: 0.9; transform: scale(1.045); }
      to { opacity: 1; transform: scale(1); }
    }

    @keyframes process-wipe-left {
      from { transform: translateX(-101%); }
      to { transform: translateX(101%); }
    }

    @keyframes process-wipe-right {
      from { transform: translateX(101%); }
      to { transform: translateX(-101%); }
    }

    @keyframes process-copy-rise {
      from { opacity: 0.38; transform: translateY(22px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @keyframes process-marker {
      from { border-color: var(--c-blue-muted); background: var(--c-paper); }
      to { border-color: var(--c-blue); background: var(--c-blue); }
    }

    @keyframes process-connector {
      from { opacity: 0.5; transform: scaleY(0); }
      to { opacity: 1; transform: scaleY(1); }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .process-teaser__link span:last-child { transition: none; }
    .process-teaser__link:hover span:last-child { transform: none; }
  }
</style>
