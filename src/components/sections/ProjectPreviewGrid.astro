---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

import phWide from "../../assets/images/placeholders/kitchen-placeholder-wide-island.png";
import phDetail from "../../assets/images/placeholders/kitchen-placeholder-detail-sink.png";
import phEvening from "../../assets/images/placeholders/kitchen-placeholder-evening-teal.png";

interface ProjectCard {
  id: string;
  data: {
    title: string;
    location?: string;
    style?: string;
    summary?: string;
    heroImage?: ImageMetadata;
  };
}

interface Props {
  projects: ProjectCard[];
}

const { projects = [] } = Astro.props;

const fallbacks = [phWide, phDetail, phEvening];
const fallbackFor = (id: string) =>
  fallbacks[[...id].reduce((acc, char) => acc + char.charCodeAt(0), 0) % fallbacks.length];
---

<section id="projects" class="section section--tight">
  <div class="container section-frame stack stack--loose">
    <header class="section-intro">
      <div class="stack stack--tight">
        <p class="eyebrow">Real-life kitchens</p>
        <h2>See how thoughtful design comes to life in real homes.</h2>
      </div>
      <p class="muted text-measure">
        Explore a selection of recent projects and see how each kitchen was shaped around the home, the layout and the way it needed to work every day.
      </p>
    </header>

    <div class="project-grid">
      {projects.map((project) => {
        const image = project.data.heroImage ?? fallbackFor(project.id);
        const href = `/projects/${project.id.replace(/\/index$/, "")}/`;
        const summary =
          project.data.summary ??
          `${project.data.style ?? "Kitchen"} project${project.data.location ? ` in ${project.data.location}` : ""}.`;

        return (
          <article class="project-card">
            <a class="project-card__link" href={href}>
              <div class="media media--4x3 project-card__media">
                <Image
                  src={image}
                  alt={`${project.data.title} by Fini’s Kitchens`}
                  widths={[640, 960]}
                  sizes="(min-width: 64rem) 33vw, 100vw"
                  loading="lazy"
                />
              </div>

              <div class="project-card__body">
                <div class="project-card__meta">
                  {project.data.location && <span class="badge badge--quiet">{project.data.location}</span>}
                  {project.data.style && <span class="badge badge--quiet">{project.data.style}</span>}
                </div>

                <h3>{project.data.title}</h3>
                <p class="muted">{summary}</p>
              </div>
            </a>
          </article>
        );
      })}
    </div>

    <div>
      <a class="btn btn--secondary" href="/projects">See all projects</a>
    </div>
  </div>
</section>

<style>
  .project-grid {
    display: grid;
    gap: var(--space-6);
  }

  .project-card {
    border-radius: var(--radius-xl);
    overflow: hidden;
    border: var(--border-1) solid var(--c-border);
    background: var(--c-surface);
    box-shadow: var(--shadow-1);
  }

  .project-card__link {
    display: grid;
    height: 100%;
  }

  .project-card__media {
    border-radius: 0;
    border-bottom: var(--border-1) solid var(--c-border);
  }

  .project-card__body {
    padding: var(--space-6);
    display: grid;
    gap: var(--space-3);
  }

  .project-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  @media (min-width: 48rem) {
    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 72rem) {
    .project-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>