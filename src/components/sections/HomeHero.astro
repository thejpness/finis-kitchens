---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  /**
   * Kept as a prop so the approved blue kitchen photography can replace this
   * asset without changing the hero's structure or responsive behaviour.
   */
  image: ImageMetadata;
}

const { image } = Astro.props;
---

<section class="home-hero" aria-labelledby="home-hero-title">
  <div class="home-hero__media">
    <Image
      class="home-hero__image"
      src={image}
      alt="A warm contemporary kitchen with pale cabinetry, timber shelving and an island."
      widths={[640, 960, 1376]}
      sizes="100vw"
      priority
    />
  </div>

  <div class="home-hero__overlay" aria-hidden="true"></div>

  <div class="container home-hero__inner">
    <div class="home-hero__content">
      <p class="home-hero__eyebrow">Fini's Kitchens</p>
      <h1 id="home-hero-title" class="home-hero__title">Kitchens for real life.</h1>
      <p class="home-hero__supporting">Thoughtful design. Beautifully considered.</p>
    </div>

    <a class="home-hero__scroll" href="#home-content">
      <span>Explore</span>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M12 4v15M5.5 12.5 12 19l6.5-6.5" />
      </svg>
    </a>
  </div>
</section>

<style>
  .home-hero {
    position: relative;
    isolation: isolate;
    display: grid;
    min-height: 100vh;
    min-height: 100svh;
    margin-top: -5.1rem;
    overflow: clip;
    color: #fff;
    background: #263746;
  }

  .home-hero__media,
  .home-hero__overlay {
    position: absolute;
    inset: 0;
  }

  .home-hero__media {
    z-index: -2;
  }

  .home-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 57% center;
  }

  .home-hero__overlay {
    z-index: -1;
    background:
      linear-gradient(90deg, rgba(9, 23, 38, 0.78) 0%, rgba(12, 29, 46, 0.58) 38%, rgba(12, 29, 46, 0.22) 68%, rgba(12, 29, 46, 0.14) 100%),
      linear-gradient(180deg, rgba(7, 18, 30, 0.34) 0%, rgba(7, 18, 30, 0) 32%, rgba(7, 18, 30, 0.24) 100%);
  }

  .home-hero__inner {
    display: grid;
    grid-template-rows: 1fr auto;
    min-height: inherit;
    padding-top: clamp(7.75rem, 16vh, 10.5rem);
    padding-bottom: clamp(1.5rem, 4vh, 2.5rem);
  }

  .home-hero__content {
    align-self: center;
    max-width: 39rem;
  }

  .home-hero__eyebrow {
    margin-bottom: var(--space-4);
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.78);
  }

  .home-hero__title {
    max-width: 10ch;
    color: #fff;
    font-size: clamp(3.15rem, 7vw, 6.5rem);
    font-weight: 600;
    line-height: 0.94;
    letter-spacing: -0.055em;
    text-wrap: balance;
    text-shadow: 0 2px 24px rgba(7, 18, 30, 0.2);
  }

  .home-hero__supporting {
    max-width: 32rem;
    margin-top: var(--space-5);
    font-size: clamp(1.05rem, 1.4vw, 1.25rem);
    line-height: var(--lh-snug);
    color: rgba(255, 255, 255, 0.88);
  }

  .home-hero__scroll {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    width: fit-content;
    min-height: 2.75rem;
    padding-bottom: var(--space-2);
    color: rgba(255, 255, 255, 0.9);
    font-size: var(--fs-0);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  .home-hero__scroll::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background: rgba(255, 255, 255, 0.72);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-2) var(--ease-out);
  }

  .home-hero__scroll svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
    transition: transform var(--dur-2) var(--ease-out);
  }

  .home-hero__scroll:hover::after,
  .home-hero__scroll:focus-visible::after {
    transform: scaleX(1);
  }

  .home-hero__scroll:hover svg {
    transform: translateY(0.18rem);
  }

  .home-hero__scroll:focus-visible {
    outline-color: #fff;
    outline-offset: 5px;
  }

  @media (max-width: 53.74rem) {
    .home-hero {
      margin-top: -4.15rem;
    }

    .home-hero__image {
      object-position: 62% center;
    }

    .home-hero__overlay {
      background:
        linear-gradient(180deg, rgba(8, 21, 35, 0.66) 0%, rgba(10, 25, 40, 0.4) 42%, rgba(8, 21, 35, 0.6) 100%),
        linear-gradient(90deg, rgba(8, 21, 35, 0.32), rgba(8, 21, 35, 0.08));
    }

    .home-hero__inner {
      padding-top: clamp(7rem, 16vh, 9rem);
      padding-bottom: max(1.35rem, env(safe-area-inset-bottom));
    }

    .home-hero__content {
      align-self: end;
      margin-bottom: clamp(3.5rem, 9vh, 6rem);
    }

    .home-hero__title {
      font-size: clamp(3rem, 14vw, 4.75rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero__scroll::after,
    .home-hero__scroll svg {
      transition: none;
    }

    .home-hero__scroll:hover svg {
      transform: none;
    }
  }
</style>
