---
interface StoryBookPage {
  label: string;
  src: string;
  alt: string;
}

interface Props {
  viewerId: string;
  eyebrow?: string;
  title: string;
  intro?: string;
  buttonLabel?: string;
  pages: StoryBookPage[];
}

const {
  viewerId,
  eyebrow = "Illustrated storybook",
  title,
  intro,
  buttonLabel = "Open the storybook",
  pages
} = Astro.props;
---

<section class="section storybook-viewer" id="storybook" aria-labelledby={`${viewerId}-heading`}>
  <div class="container">
    <div class="storybook-viewer__panel">
      <div class="section-head">
        <div class="section-head__copy">
          <p class="eyebrow">{eyebrow}</p>
          <h2 class="section-head__title" id={`${viewerId}-heading`}>{title}</h2>
          {intro && <p class="section-head__desc">{intro}</p>}
        </div>
      </div>

      <div class="storybook-viewer__actions">
        <button
          type="button"
          class="btn btn--primary"
          data-storybook-open={viewerId}
          data-storybook-index="0"
        >
          {buttonLabel}
        </button>
      </div>
    </div>
  </div>

  <dialog class="storybook-dialog" data-storybook-viewer={viewerId} aria-label={title}>
    <div class="storybook-dialog__shell">
      <div class="storybook-dialog__topbar">
        <p class="storybook-dialog__counter" data-storybook-counter>1 / {pages.length}</p>

        <button type="button" class="storybook-dialog__close" data-storybook-close aria-label="Close storybook">
          ×
        </button>
      </div>

      <div class="storybook-dialog__stage">
        <button
          type="button"
          class="storybook-dialog__nav storybook-dialog__nav--prev"
          data-storybook-prev
          aria-label="Previous page"
        >
          ‹
        </button>

        <div class="storybook-dialog__slides">
          {pages.map((page, index) => (
            <figure
              class:list={["storybook-dialog__slide", index === 0 && "is-active"]}
              data-storybook-slide={index}
              aria-hidden={index === 0 ? "false" : "true"}
            >
              <img src={page.src} alt={page.alt} loading="lazy" decoding="async" />
              <figcaption>{page.label}</figcaption>
            </figure>
          ))}
        </div>

        <button
          type="button"
          class="storybook-dialog__nav storybook-dialog__nav--next"
          data-storybook-next
          aria-label="Next page"
        >
          ›
        </button>
      </div>

      <div class="storybook-dialog__thumbs" aria-label="Storybook pages">
        {pages.map((page, index) => (
          <button
            type="button"
            class:list={["storybook-dialog__thumb", index === 0 && "is-active"]}
            data-storybook-thumb={index}
            aria-label={`Open ${page.label}`}
          >
            <img src={page.src} alt="" loading="lazy" decoding="async" />
          </button>
        ))}
      </div>
    </div>
  </dialog>
</section>

<style>
  .storybook-viewer__panel {
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-radius: calc(var(--radius-xl) + 0.15rem);
    border: var(--border-1) solid var(--c-border);
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--c-surface) 96%, white 4%),
        color-mix(in srgb, var(--c-surface) 100%, transparent 0%)
      );
  }

  .storybook-viewer__actions {
    margin-top: 1.25rem;
  }

  .storybook-dialog {
    width: min(100vw - 1.5rem, 92rem);
    max-width: 92rem;
    height: min(100vh - 1.5rem, 96vh);
    max-height: 96vh;
    padding: 0;
    border: 0;
    border-radius: 1.25rem;
    background: color-mix(in srgb, var(--c-surface) 96%, white 4%);
    color: var(--c-text);
  }

  .storybook-dialog::backdrop {
    background: rgba(15, 23, 42, 0.72);
    backdrop-filter: blur(8px);
  }

  .storybook-dialog__shell {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    height: 100%;
    min-height: 0;
  }

  .storybook-dialog__topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1rem 0;
  }

  .storybook-dialog__counter {
    margin: 0;
    font-weight: 600;
  }

  .storybook-dialog__close {
    border: 0;
    background: transparent;
    font-size: 2rem;
    line-height: 1;
    cursor: pointer;
    color: inherit;
  }

  .storybook-dialog__stage {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.5rem;
    align-items: center;
    min-height: 0;
    padding: 0.75rem 0.75rem 0;
  }

  .storybook-dialog__slides {
    min-height: 0;
    height: 100%;
    display: grid;
    place-items: center;
    overflow: hidden;
    position: relative;
  }

  .storybook-dialog__slide {
    display: none;
    margin: 0;
    width: 100%;
    height: 100%;
    gap: 0.75rem;
    align-content: center;
    justify-items: center;
  }

  .storybook-dialog__slide.is-active {
    display: grid;
  }

  .storybook-dialog__slide img {
    display: block;
    width: auto;
    max-width: 100%;
    max-height: calc(96vh - 12rem);
    height: auto;
    border-radius: var(--radius-l);
    background: white;
  }

  .storybook-dialog__slide figcaption {
    font-size: 0.95rem;
    color: var(--c-muted);
    text-align: center;
  }

  .storybook-dialog__nav {
    width: 3rem;
    height: 3rem;
    border-radius: 999px;
    border: var(--border-1) solid var(--c-border);
    background: color-mix(in srgb, var(--c-surface) 92%, white 8%);
    color: inherit;
    font-size: 2rem;
    line-height: 1;
    cursor: pointer;
  }

  .storybook-dialog__thumbs {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 5rem;
    gap: 0.5rem;
    overflow-x: auto;
    padding: 0.75rem 1rem 1rem;
  }

  .storybook-dialog__thumb {
    padding: 0;
    border: var(--border-1) solid var(--c-border);
    border-radius: 0.75rem;
    overflow: hidden;
    background: white;
    cursor: pointer;
  }

  .storybook-dialog__thumb img {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .storybook-dialog__thumb.is-active {
    outline: 2px solid color-mix(in srgb, var(--c-brand-2) 55%, var(--c-text) 45%);
    outline-offset: 1px;
  }

  @media (max-width: 720px) {
    .storybook-dialog {
      width: 100vw;
      height: 100vh;
      max-width: none;
      max-height: none;
      border-radius: 0;
    }

    .storybook-dialog__stage {
      grid-template-columns: 1fr;
      padding-inline: 0.5rem;
    }

    .storybook-dialog__nav {
      display: none;
    }

    .storybook-dialog__slide img {
      max-height: calc(100vh - 11rem);
    }
  }
</style>

<script is:inline>
  (() => {
    const viewers = document.querySelectorAll("[data-storybook-viewer]");

    viewers.forEach((dialog) => {
      if (!(dialog instanceof HTMLDialogElement)) return;

      const viewerId = dialog.getAttribute("data-storybook-viewer");
      if (!viewerId) return;

      const slides = Array.from(dialog.querySelectorAll("[data-storybook-slide]"));
      const thumbs = Array.from(dialog.querySelectorAll("[data-storybook-thumb]"));
      const counter = dialog.querySelector("[data-storybook-counter]");
      const prevButton = dialog.querySelector("[data-storybook-prev]");
      const nextButton = dialog.querySelector("[data-storybook-next]");
      const closeButton = dialog.querySelector("[data-storybook-close]");

      let index = 0;
      let touchStartX = 0;
      let touchEndX = 0;

      const render = () => {
        slides.forEach((slide, i) => {
          slide.classList.toggle("is-active", i === index);
          slide.setAttribute("aria-hidden", i === index ? "false" : "true");
        });

        thumbs.forEach((thumb, i) => {
          thumb.classList.toggle("is-active", i === index);
        });

        const activeThumb = thumbs[index];
        activeThumb?.scrollIntoView({
          behavior: "smooth",
          inline: "center",
          block: "nearest",
        });

        if (counter) {
          counter.textContent = `${index + 1} / ${slides.length}`;
        }
      };

      const openAt = (nextIndex) => {
        index = Math.max(0, Math.min(nextIndex, slides.length - 1));
        render();
        if (!dialog.open) dialog.showModal();
        document.documentElement.style.overflow = "hidden";
      };

      const close = () => {
        if (dialog.open) dialog.close();
        document.documentElement.style.overflow = "";
      };

      const next = () => {
        index = (index + 1) % slides.length;
        render();
      };

      const prev = () => {
        index = (index - 1 + slides.length) % slides.length;
        render();
      };

      document.querySelectorAll(`[data-storybook-open="${viewerId}"]`).forEach((trigger) => {
        trigger.addEventListener("click", (event) => {
          event.preventDefault();
          const requestedIndex = Number(trigger.getAttribute("data-storybook-index") || "0");
          openAt(requestedIndex);
        });
      });

      thumbs.forEach((thumb, thumbIndex) => {
        thumb.addEventListener("click", () => {
          index = thumbIndex;
          render();
        });
      });

      prevButton?.addEventListener("click", prev);
      nextButton?.addEventListener("click", next);
      closeButton?.addEventListener("click", close);

      dialog.addEventListener("click", (event) => {
        const rect = dialog.getBoundingClientRect();
        const clickedOutside =
          event.clientX < rect.left ||
          event.clientX > rect.right ||
          event.clientY < rect.top ||
          event.clientY > rect.bottom;

        if (clickedOutside) close();
      });

      dialog.addEventListener("close", () => {
        document.documentElement.style.overflow = "";
      });

      dialog.addEventListener("keydown", (event) => {
        if (event.key === "ArrowRight") next();
        if (event.key === "ArrowLeft") prev();
        if (event.key === "Escape") close();
      });

      const stage = dialog.querySelector(".storybook-dialog__slides");
      stage?.addEventListener("touchstart", (event) => {
        touchStartX = event.changedTouches[0].clientX;
      });

      stage?.addEventListener("touchend", (event) => {
        touchEndX = event.changedTouches[0].clientX;
        const delta = touchEndX - touchStartX;

        if (Math.abs(delta) < 40) return;
        if (delta < 0) next();
        if (delta > 0) prev();
      });

      render();
    });
  })();
</script>